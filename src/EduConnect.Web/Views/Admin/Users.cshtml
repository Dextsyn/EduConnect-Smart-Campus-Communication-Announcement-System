@model EduConnect.Web.ViewModels.UserListViewModel
@{
    ViewData["Title"] = "Manage Users";
    var roles = ViewBag.Roles as
        List<EduConnect.Web.Models.Role>
        ?? new List<EduConnect.Web.Models.Role>();
    var colleges = ViewBag.Colleges as List<College> ?? new List<College>();
    var hierarchy = ViewBag.Hierarchy as List<College> ?? new List<College>();
    var filterCollege = Model.FilterCollege;
}

<!-- ─── PAGE HEADER ──────────────────── -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-people me-2 text-primary"></i>
            Manage Users
        </h4>
        <small class="text-muted" aria-live="polite"><span id="usersTotal">@Model.TotalCount</span> total users</small>
    </div>
    <div class="d-flex gap-2">
        <a href="/Admin/AddUser" class="btn btn-primary btn-sm">
            <i class="bi bi-person-plus me-1"></i>Add User
        </a>
        <a href="/Admin" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-2"></i>Back
        </a>
    </div>
</div>

<!-- ─── SUCCESS MESSAGE ──────────────── -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success
                    alert-dismissible mb-4">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["Success"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible mb-4">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if ((int)(ViewBag.NeedsPlacementCount ?? 0) > 0 && Model.FilterPlacement != "missing")
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center mb-4">
        <span>
            <i class="bi bi-diagram-3 me-2"></i>
            @ViewBag.NeedsPlacementCount user(s) still need a college, department or program.
        </span>
        <a href="/Admin/Users?filterPlacement=missing" class="btn btn-sm btn-warning">Show them</a>
    </div>
}

<!-- ─── FILTERS ──────────────────────── -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2" id="userFilters">

            <div class="col-12 col-md-3">
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="search"
                           name="searchQuery"
                           id="userSearch"
                           value="@Model.SearchQuery"
                           class="form-control"
                           autocomplete="off"
                           aria-controls="usersResults"
                           placeholder="Search name, email, ID..." />
                </div>
            </div>

            <div class="col-6 col-md-2">
                <select name="filterRole"
                        class="form-select">
                    <option value="">All Roles</option>
                    @foreach (var role in roles)
                    {
                        <option value="@role.RoleName"
                                selected="@(Model.FilterRole == role.RoleName)">
                            @role.RoleName
                        </option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-2">
                <select name="filterStatus"
                        class="form-select">
                    <option value="">All Status</option>
                    <option value="Verified"
                            selected="@(Model.FilterStatus == "Verified")">
                        Verified
                    </option>
                    <option value="Rejected"
                            selected="@(Model.FilterStatus == "Rejected")">
                        Rejected
                    </option>
                    <option value="@VerificationStatuses.EmailPending"
                            selected="@(Model.FilterStatus == VerificationStatuses.EmailPending)">
                        Email not confirmed
                    </option>
                </select>
            </div>

            <div class="col-6 col-md-2">
                <select name="filterCollege" class="form-select" aria-label="College">
                    <option value="">All colleges</option>
                    @foreach (var c in colleges)
                    {
                        <option value="@c.CollegeID" selected="@(filterCollege == c.CollegeID)">
                            @(c.ShortName ?? c.Name)@(c.IsActive ? "" : " (retired)")
                        </option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-2">
                <select name="filterPlacement" class="form-select">
                    <option value="">Any placement</option>
                    <option value="missing" selected="@(Model.FilterPlacement == "missing")">
                        Needs placement
                    </option>
                </select>
            </div>

            <div class="col-12 col-md-1
                        d-flex gap-2">
                <button type="submit"
                        class="btn btn-primary
                               flex-fill" title="Filter">
                    <i class="bi bi-funnel"></i>
                </button>
                <a href="/Admin/Users"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-x"></i>
                </a>
            </div>

        </form>
    </div>
</div>

<!-- ─── BULK MOVE ────────────────────── -->
<!-- Shown once users are ticked; the row checkboxes join this form via form="bulkMoveForm". -->
<form id="bulkMoveForm" asp-action="BulkMove" method="post"
      class="card border-0 shadow-sm mb-4 d-none">
    <input type="hidden" name="returnQuery" id="bulkReturnQuery" value="@Context.Request.QueryString" />
    <div class="card-body">
        <div class="fw-semibold mb-2">
            <i class="bi bi-arrow-left-right me-1 text-primary"></i>
            Move <span id="bulkCount">0</span> selected user(s) to
        </div>
        <div class="row g-2">
            <div class="col-12 col-md-4">
                <select name="collegeId" id="moveCollege" class="form-select" required aria-label="College">
                    <option value="">— College —</option>
                    @foreach (var c in hierarchy)
                    {
                        <option value="@c.CollegeID" data-flat="@(c.Departments.Any(d => d.IsImplicit) ? "1" : "0")">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <select name="departmentId" id="moveDept" class="form-select" aria-label="Department">
                    <option value="">— Department —</option>
                    @foreach (var c in hierarchy)
                    {
                        foreach (var d in c.Departments.Where(d => !d.IsImplicit))
                        {
                            <option value="@d.DepartmentID" data-college="@c.CollegeID">@d.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <select name="programId" id="moveProgram" class="form-select" aria-label="Program">
                    <option value="">— Program —</option>
                    @foreach (var c in hierarchy)
                    {
                        foreach (var d in c.Departments)
                        {
                            foreach (var p in d.Programs)
                            {
                                <option value="@p.ProgramID" data-college="@c.CollegeID"
                                        data-department="@(d.IsImplicit ? "" : d.DepartmentID.ToString())">@p.Name</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bi bi-arrow-right-circle me-1"></i>Move
                </button>
                <button type="button" class="btn btn-outline-secondary" id="bulkClear" title="Clear selection">
                    <i class="bi bi-x"></i>
                </button>
            </div>
        </div>
        <div class="form-text">
            Students need a program; Chairpersons and Faculty a department (or a college without
            departments); Deans just the college. Anyone who doesn't fit is skipped and listed.
        </div>
    </div>
</form>

<!-- ─── USERS TABLE + PAGER ──────────── -->
<!-- The as-you-type search swaps this block for /Admin/Users?partial=true. -->
<div id="usersResults">
    <partial name="_UsersTable" model="Model" />
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('bulkMoveForm');
            const count = document.getElementById('bulkCount');
            const results = document.getElementById('usersResults');
            const checks = () => [...results.querySelectorAll('.bulk-check')];
            const college = document.getElementById('moveCollege');
            const dept = document.getElementById('moveDept');
            const program = document.getElementById('moveProgram');

            // The table is replaced by the live search, so the checkbox
            // listeners sit on its container rather than on each box.
            function sync() {
                const all = document.getElementById('bulkAll');
                const n = checks().filter(c => c.checked).length;
                count.textContent = n;
                form.classList.toggle('d-none', n === 0);
                all.checked = n > 0 && n === checks().length;
                all.indeterminate = n > 0 && n < checks().length;
            }

            results.addEventListener('change', e => {
                if (e.target.id === 'bulkAll')
                    checks().forEach(c => c.checked = e.target.checked);
                if (e.target.id === 'bulkAll' || e.target.classList.contains('bulk-check'))
                    sync();
            });
            document.getElementById('bulkClear').addEventListener('click', () => {
                checks().forEach(c => c.checked = false);
                sync();
            });

            // Department and program lists follow the chosen college and
            // department, as on the Add/Edit User form.
            function filter(select, keep) {
                for (const opt of select.options) {
                    if (!opt.value) continue;
                    const show = keep(opt);
                    opt.hidden = !show;
                    opt.disabled = !show;
                }
                const current = select.options[select.selectedIndex];
                if (current && current.disabled) select.value = '';
            }
            function refresh() {
                const opt = college.options[college.selectedIndex];
                const flat = opt && opt.dataset.flat === '1';
                dept.closest('div').hidden = flat;
                if (flat) dept.value = '';
                filter(dept, o => o.dataset.college === college.value);
                filter(program, o => o.dataset.college === college.value &&
                    (flat || !dept.value || o.dataset.department === dept.value));
            }
            college.addEventListener('change', refresh);
            dept.addEventListener('change', refresh);
            refresh();

            form.addEventListener('submit', function (e) {
                const dest = [college, dept, program]
                    .map(s => s.value ? s.options[s.selectedIndex].text : '')
                    .filter(Boolean).join(' / ');
                if (!confirm('Move ' + count.textContent + ' user(s) to ' + dest + '?'))
                    e.preventDefault();
            });

            sync();

            // ─── As-you-type search ───────────────
            // Runs on the server (only one page is in the browser) once typing
            // pauses, from 2 letters; clearing the box brings everyone back.
            // The other filters stay applied and results start at page 1.
            // Enter and the filter button still submit the form normally.
            const filters = document.getElementById('userFilters');
            const search = document.getElementById('userSearch');
            const total = document.getElementById('usersTotal');
            const returnQuery = document.getElementById('bulkReturnQuery');
            let timer = null;
            let pending = null;
            let lastQuery = search.value.trim();

            function query() {
                const params = new URLSearchParams();
                for (const [key, value] of new FormData(filters)) {
                    const v = String(value).trim();
                    if (v) params.set(key, v);
                }
                return params;
            }

            async function run() {
                const params = query();
                if (pending) pending.abort();
                pending = new AbortController();
                const live = new URLSearchParams(params);
                live.set('partial', 'true'); // MVC reads a bool only from true/false, not 1
                try {
                    const res = await fetch('/Admin/Users?' + live, {
                        signal: pending.signal,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    const html = res.ok && !res.redirected ? await res.text() : '';
                    // Anything but the bare table (a sign-in page, an error
                    // page) falls back to a normal page load.
                    if (!html.trimStart().startsWith('<div data-total=')) { filters.submit(); return; }
                    results.innerHTML = html;
                } catch (err) {
                    if (err.name === 'AbortError') return; // a newer search replaced it
                    filters.submit();
                    return;
                }
                const shown = results.querySelector('[data-total]');
                if (shown) total.textContent = shown.dataset.total;
                const qs = params.toString() ? '?' + params : '';
                history.replaceState(null, '', location.pathname + qs);
                returnQuery.value = qs;
                sync();
            }

            search.addEventListener('input', () => {
                clearTimeout(timer);
                const q = search.value.trim();
                if (q === lastQuery || q.length === 1) return;
                timer = setTimeout(() => { lastQuery = q; run(); }, 300);
            });
        })();
    </script>
}
