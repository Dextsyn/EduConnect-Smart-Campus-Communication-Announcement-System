@{
    ViewData["Title"] = "Manage Users";
    var users = ViewBag.Users as
        List<EduConnect.Web.Models.User>
        ?? new List<EduConnect.Web.Models.User>();
    var roles = ViewBag.Roles as
        List<EduConnect.Web.Models.Role>
        ?? new List<EduConnect.Web.Models.Role>();
    var colleges = ViewBag.Colleges as List<College> ?? new List<College>();
    var hierarchy = ViewBag.Hierarchy as List<College> ?? new List<College>();
    var filterCollege = ViewBag.FilterCollege as int?;

    // Only these roles have a placement to move.
    var movableRoles = new[] { RoleNames.Dean, RoleNames.Chairperson, RoleNames.Faculty,
                               RoleNames.Student, RoleNames.StudentPending };
}

<!-- ─── PAGE HEADER ──────────────────── -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-people me-2 text-primary"></i>
            Manage Users
        </h4>
        <small class="text-muted">@users.Count total users</small>
    </div>
    <div class="d-flex gap-2">
        <a href="/Admin/AddUser" class="btn btn-primary btn-sm">
            <i class="bi bi-person-plus me-1"></i>Add User
        </a>
        <a href="/Admin" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-2"></i>Back
        </a>
    </div>
</div>

<!-- ─── SUCCESS MESSAGE ──────────────── -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success
                    alert-dismissible mb-4">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["Success"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible mb-4">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if ((int)(ViewBag.NeedsPlacementCount ?? 0) > 0 && ViewBag.FilterPlacement != "missing")
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center mb-4">
        <span>
            <i class="bi bi-diagram-3 me-2"></i>
            @ViewBag.NeedsPlacementCount user(s) still need a college, department or program.
        </span>
        <a href="/Admin/Users?filterPlacement=missing" class="btn btn-sm btn-warning">Show them</a>
    </div>
}

<!-- ─── FILTERS ──────────────────────── -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2">

            <div class="col-12 col-md-3">
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text"
                           name="searchQuery"
                           value="@ViewBag.SearchQuery"
                           class="form-control"
                           placeholder="Search name, email, ID..." />
                </div>
            </div>

            <div class="col-6 col-md-2">
                <select name="filterRole"
                        class="form-select">
                    <option value="">All Roles</option>
                    @foreach (var role in roles)
                    {
                        <option value="@role.RoleName"
                                selected="@(ViewBag.FilterRole == role.RoleName)">
                            @role.RoleName
                        </option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-2">
                <select name="filterStatus"
                        class="form-select">
                    <option value="">All Status</option>
                    <option value="Verified"
                            selected="@(ViewBag.FilterStatus == "Verified")">
                        Verified
                    </option>
                    <option value="Pending"
                            selected="@(ViewBag.FilterStatus == "Pending")">
                        Pending
                    </option>
                    <option value="Rejected"
                            selected="@(ViewBag.FilterStatus == "Rejected")">
                        Rejected
                    </option>
                </select>
            </div>

            <div class="col-6 col-md-2">
                <select name="filterCollege" class="form-select" aria-label="College">
                    <option value="">All colleges</option>
                    @foreach (var c in colleges)
                    {
                        <option value="@c.CollegeID" selected="@(filterCollege == c.CollegeID)">
                            @(c.ShortName ?? c.Name)@(c.IsActive ? "" : " (retired)")
                        </option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-2">
                <select name="filterPlacement" class="form-select">
                    <option value="">Any placement</option>
                    <option value="missing" selected="@(ViewBag.FilterPlacement == "missing")">
                        Needs placement
                    </option>
                </select>
            </div>

            <div class="col-12 col-md-1
                        d-flex gap-2">
                <button type="submit"
                        class="btn btn-primary
                               flex-fill" title="Filter">
                    <i class="bi bi-funnel"></i>
                </button>
                <a href="/Admin/Users"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-x"></i>
                </a>
            </div>

        </form>
    </div>
</div>

<!-- ─── BULK MOVE ────────────────────── -->
<!-- Shown once users are ticked; the row checkboxes join this form via form="bulkMoveForm". -->
<form id="bulkMoveForm" asp-action="BulkMove" method="post"
      class="card border-0 shadow-sm mb-4 d-none">
    <input type="hidden" name="returnQuery" value="@Context.Request.QueryString" />
    <div class="card-body">
        <div class="fw-semibold mb-2">
            <i class="bi bi-arrow-left-right me-1 text-primary"></i>
            Move <span id="bulkCount">0</span> selected user(s) to
        </div>
        <div class="row g-2">
            <div class="col-12 col-md-4">
                <select name="collegeId" id="moveCollege" class="form-select" required aria-label="College">
                    <option value="">— College —</option>
                    @foreach (var c in hierarchy)
                    {
                        <option value="@c.CollegeID" data-flat="@(c.Departments.Any(d => d.IsImplicit) ? "1" : "0")">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <select name="departmentId" id="moveDept" class="form-select" aria-label="Department">
                    <option value="">— Department —</option>
                    @foreach (var c in hierarchy)
                    {
                        foreach (var d in c.Departments.Where(d => !d.IsImplicit))
                        {
                            <option value="@d.DepartmentID" data-college="@c.CollegeID">@d.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <select name="programId" id="moveProgram" class="form-select" aria-label="Program">
                    <option value="">— Program —</option>
                    @foreach (var c in hierarchy)
                    {
                        foreach (var d in c.Departments)
                        {
                            foreach (var p in d.Programs)
                            {
                                <option value="@p.ProgramID" data-college="@c.CollegeID"
                                        data-department="@(d.IsImplicit ? "" : d.DepartmentID.ToString())">@p.Name</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bi bi-arrow-right-circle me-1"></i>Move
                </button>
                <button type="button" class="btn btn-outline-secondary" id="bulkClear" title="Clear selection">
                    <i class="bi bi-x"></i>
                </button>
            </div>
        </div>
        <div class="form-text">
            Students need a program; Chairpersons and Faculty a department (or a college without
            departments); Deans just the college. Anyone who doesn't fit is skipped and listed.
        </div>
    </div>
</form>

<!-- ─── USERS TABLE ──────────────────── -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width:2rem">
                            <input type="checkbox" class="form-check-input" id="bulkAll"
                                   title="Select all that can be moved" aria-label="Select all" />
                        </th>
                        <th>User</th>
                        <th>Student ID</th>
                        <th>Placement</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Registered</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!users.Any())
                    {
                        <tr>
                            <td colspan="8"
                                class="text-center
                                            py-5 text-muted">
                                <i class="bi bi-people
                                               fs-1 d-block
                                               mb-2"></i>
                                No users found
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in users)
                        {
                            var dept = user.UserDepartments
                            .FirstOrDefault(
                            ud => ud.IsPrimary);

                            <tr>
                                <!-- Select for bulk move -->
                                <td class="ps-3">
                                    @if (movableRoles.Contains(user.Role.RoleName))
                                    {
                                        <input type="checkbox" class="form-check-input bulk-check"
                                               form="bulkMoveForm" name="userIds" value="@user.UserID"
                                               aria-label="Select @user.FirstName @user.LastName" />
                                    }
                                </td>

                                <!-- User -->
                                <td>
                                    <div class="d-flex
                                                        align-items-center
                                                        gap-2">
                                        <img src="https://ui-avatars.com/api/?name=@user.FirstName+@user.LastName&background=002F6C&color=fff&size=32"
                                             class="rounded-circle"
                                             width="32"
                                             height="32" />
                                        <div>
                                            <div class="fw-semibold
                                                                small">
                                                @user.FirstName
                                                @user.LastName
                                            </div>
                                            <div class="text-muted"
                                                 style="font-size:11px">
                                                @user.Email
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Student ID -->
                                <td class="small text-muted">
                                    @(user.StudentID ?? "—")
                                </td>

                                <!-- Placement -->
                                <td class="small">
                                    @if (user.AcademicProgram != null)
                                    {
                                        <div>@(user.AcademicProgram.ShortName ?? user.AcademicProgram.Name)</div>
                                    }
                                    else if (user.Department != null && !user.Department.IsImplicit)
                                    {
                                        <div>@(user.Department.ShortName ?? user.Department.Name)</div>
                                    }
                                    @if (user.College != null)
                                    {
                                        <div class="text-muted" style="font-size:11px">@(user.College.ShortName ?? user.College.Name)</div>
                                    }
                                    else if (user.AcademicProgram == null && user.Department == null)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    @if (dept?.DepartmentTag != null)
                                    {
                                        <span class="badge bg-light text-dark border mt-1" title="Feed tag">
                                            @dept.DepartmentTag.ShortName
                                        </span>
                                    }
                                </td>

                                <!-- Role -->
                                <td>
                                    <span class="badge bg-primary bg-opacity-10
                                                 text-primary border border-primary
                                                 border-opacity-25 small">
                                        @user.Role.RoleName
                                    </span>
                                </td>

                                <!-- Status -->
                                <td>
                                    @if (user.VerificationStatus
                                                                == "Verified" &&
                                                                user.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Verified
                                        </span>
                                    }
                                    else if (user.VerificationStatus
                                    == "Pending")
                                    {
                                        <span class="badge bg-warning
                                                                 text-dark">
                                            Pending
                                        </span>
                                    }
                                    else if (user.VerificationStatus
                                    == "Rejected")
                                    {
                                        <span class="badge bg-danger">
                                            Rejected
                                        </span>
                                    }
                                    else if (!user.IsActive)
                                    {
                                        <span class="badge bg-secondary">
                                            Deactivated
                                        </span>
                                    }
                                </td>

                                <!-- Registered -->
                                <td class="text-muted small">
                                    @user.CreatedAt.ToString("MMM dd, yyyy")
                                </td>

                                <!-- Actions -->
                                <td>
                                    <div class="d-flex gap-1">
                                        <a href="/Admin/EditUser/@user.UserID"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal-@user.UserID">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>

                            </tr>
                        }
                    }
                </tbody>
            </table>
            @foreach (var user in users)
            {
                <div class="modal fade" id="deleteModal-@user.UserID"
                     tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header border-0">
                                <h5 class="modal-title fw-bold text-danger">
                                    <i class="bi bi-exclamation-triangle me-2"></i>
                                    Delete User
                                </h5>
                                <button type="button" class="btn-close"
                                        data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p>Permanently delete
                                    <strong>@user.FirstName @user.LastName</strong>?
                                </p>
                                <p class="text-muted small mb-0">
                                    This action cannot be undone. Users with authored
                                    announcements or organized events cannot be deleted.
                                </p>
                            </div>
                            <div class="modal-footer border-0">
                                <button type="button" class="btn btn-outline-secondary"
                                        data-bs-dismiss="modal">Cancel</button>
                                <form asp-action="DeleteUser" asp-route-id="@user.UserID"
                                      method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('bulkMoveForm');
            const count = document.getElementById('bulkCount');
            const all = document.getElementById('bulkAll');
            const checks = () => [...document.querySelectorAll('.bulk-check')];
            const college = document.getElementById('moveCollege');
            const dept = document.getElementById('moveDept');
            const program = document.getElementById('moveProgram');

            function sync() {
                const n = checks().filter(c => c.checked).length;
                count.textContent = n;
                form.classList.toggle('d-none', n === 0);
                all.checked = n > 0 && n === checks().length;
                all.indeterminate = n > 0 && n < checks().length;
            }

            all.addEventListener('change', () => { checks().forEach(c => c.checked = all.checked); sync(); });
            checks().forEach(c => c.addEventListener('change', sync));
            document.getElementById('bulkClear').addEventListener('click', () => {
                checks().forEach(c => c.checked = false);
                sync();
            });

            // Department and program lists follow the chosen college and
            // department, as on the Add/Edit User form.
            function filter(select, keep) {
                for (const opt of select.options) {
                    if (!opt.value) continue;
                    const show = keep(opt);
                    opt.hidden = !show;
                    opt.disabled = !show;
                }
                const current = select.options[select.selectedIndex];
                if (current && current.disabled) select.value = '';
            }
            function refresh() {
                const opt = college.options[college.selectedIndex];
                const flat = opt && opt.dataset.flat === '1';
                dept.closest('div').hidden = flat;
                if (flat) dept.value = '';
                filter(dept, o => o.dataset.college === college.value);
                filter(program, o => o.dataset.college === college.value &&
                    (flat || !dept.value || o.dataset.department === dept.value));
            }
            college.addEventListener('change', refresh);
            dept.addEventListener('change', refresh);
            refresh();

            form.addEventListener('submit', function (e) {
                const dest = [college, dept, program]
                    .map(s => s.value ? s.options[s.selectedIndex].text : '')
                    .filter(Boolean).join(' / ');
                if (!confirm('Move ' + count.textContent + ' user(s) to ' + dest + '?'))
                    e.preventDefault();
            });

            sync();
        })();
    </script>
}
