@{
    ViewData["Title"] = "Tags & Offices";
    var departments = ViewBag.Departments as
        List<EduConnect.Web.Models.DepartmentTag>
        ?? new List<EduConnect.Web.Models.DepartmentTag>();
    var tagTypes = ViewBag.TagTypes as
        List<EduConnect.Web.Models.TagType>
        ?? new List<EduConnect.Web.Models.TagType>();
    var userCounts = ViewBag.UserCounts as
        Dictionary<int, int> ?? new Dictionary<int, int>();
    var announcementCounts = ViewBag.AnnouncementCounts as
        Dictionary<int, int> ?? new Dictionary<int, int>();
    var collegeTagIDs = ViewBag.CollegeTagIDs as List<int> ?? new List<int>();
    var systemShortNames = ViewBag.SystemShortNames as
        string[] ?? new string[0];
}

<!-- ─── PAGE HEADER ──────────────────── -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-diagram-3 me-2 text-primary"></i>
            Tags &amp; Offices
        </h4>
        <small class="text-muted">@departments.Count tags</small>
    </div>
    <div class="d-flex gap-2">
        <a href="/Admin/AddDepartment" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Add Tag
        </a>
        <a href="/Admin" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-2"></i>Back
        </a>
    </div>
</div>

<!-- ─── SUCCESS MESSAGE ──────────────── -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success
                    alert-dismissible mb-4">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["Success"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible mb-4">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ─── FILTERS ──────────────────────── -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2">

            <div class="col-12 col-md-4">
                <select name="filterType" class="form-select">
                    <option value="">All types</option>
                    @foreach (var type in tagTypes)
                    {
                        <option value="@type.TypeName"
                                selected="@(ViewBag.FilterType as string == type.TypeName)">
                            @type.TypeName
                        </option>
                    }
                </select>
            </div>

            <div class="col-12 col-md-4">
                <select name="filterStatus" class="form-select">
                    <option value="">All statuses</option>
                    <option value="Active"
                            selected="@(ViewBag.FilterStatus as string == "Active")">
                        Active
                    </option>
                    <option value="Inactive"
                            selected="@(ViewBag.FilterStatus as string == "Inactive")">
                        Inactive
                    </option>
                </select>
            </div>

            <div class="col-12 col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-funnel me-1"></i>
                    Filter
                </button>
                <a href="/Admin/Departments"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-x"></i>
                </a>
            </div>

        </form>
    </div>
</div>

<!-- ─── DEPARTMENTS TABLE ────────────── -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Department</th>
                        <th>Short Code</th>
                        <th>Type</th>
                        <th>In Use</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!departments.Any())
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center py-5 text-muted">
                                <i class="bi bi-diagram-3
                                               fs-1 d-block mb-2"></i>
                                No departments found
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var dept in departments)
                        {
                            var isSystem = dept.ShortName != null &&
                                systemShortNames.Contains(
                                    dept.ShortName,
                                    StringComparer.OrdinalIgnoreCase);

                            var users = userCounts.ContainsKey(dept.TagID)
                                ? userCounts[dept.TagID] : 0;
                            var posts = announcementCounts.ContainsKey(dept.TagID)
                                ? announcementCounts[dept.TagID] : 0;

                            var toggleVerb = dept.IsActive ? "Retire" : "Restore";
                            var confirmMsg =
                                $"{toggleVerb} {dept.TagName}?";

                            <tr class="@(dept.IsActive ? "" : "opacity-50")">
                                <!-- Department -->
                                <td class="ps-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="rounded-circle flex-shrink-0"
                                              style="width:14px;height:14px;
                                                     background-color:@dept.ColorHex"></span>
                                        <div>
                                            <div class="fw-semibold small">
                                                @dept.TagName
                                                @if (isSystem)
                                                {
                                                    <span class="badge bg-secondary ms-1"
                                                          style="font-size:10px">
                                                        System
                                                    </span>
                                                }
                                                @if (collegeTagIDs.Contains(dept.TagID))
                                                {
                                                    <span class="badge bg-light text-dark border ms-1"
                                                          style="font-size:10px">
                                                        Now a college
                                                    </span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(dept.Description))
                                            {
                                                <div class="text-muted"
                                                     style="font-size:11px">
                                                    @dept.Description
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <!-- Short Code -->
                                <td>
                                    <span class="badge"
                                          style="background-color:@dept.ColorHex">
                                        @(dept.ShortName ?? "—")
                                    </span>
                                </td>

                                <!-- Type -->
                                <td class="small text-muted">
                                    @(dept.TagType?.TypeName ?? "—")
                                </td>

                                <!-- In Use -->
                                <td class="small text-muted">
                                    @users user@(users == 1 ? "" : "s"),
                                    @posts post@(posts == 1 ? "" : "s")
                                </td>

                                <!-- Status -->
                                <td>
                                    @if (dept.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>

                                <!-- Actions -->
                                <td>
                                    <div class="d-flex gap-1">
                                        <a href="/Admin/EditDepartment/@dept.TagID"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        @if (!isSystem && !collegeTagIDs.Contains(dept.TagID))
                                        {
                                            <form asp-action="ToggleDepartment"
                                                  asp-route-id="@dept.TagID"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm(@Json.Serialize(confirmMsg));">
                                                @Html.AntiForgeryToken()
                                                @if (dept.IsActive)
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-secondary"
                                                            title="Retire">
                                                        <i class="bi bi-archive"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success"
                                                            title="Restore">
                                                        <i class="bi bi-arrow-counterclockwise"></i>
                                                    </button>
                                                }
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<p class="text-muted small mt-3 mb-0">
    <i class="bi bi-info-circle me-1"></i>
    Tags drive the current announcement feed: School Wide and the non-academic
    offices. Colleges, departments and programs are managed under Academic
    Structure. Tags are retired rather than deleted.
</p>
