@{
    var currentRole = Context.Session.GetString("RoleName");
    var dashboardLabel = currentRole == RoleNames.Chairperson ? "Chairperson Dashboard" : "Dean Dashboard";
    ViewData["Title"] = dashboardLabel;
    var userName = Context.Session
        .GetString("UserName");
    var pending = ViewBag.Pending as EduConnect.Web.ViewModels.PendingAnnouncementsViewModel
        ?? new EduConnect.Web.ViewModels.PendingAnnouncementsViewModel();
    var recentList =
        ViewBag.RecentAnnouncements as
        List<EduConnect.Web.Models.Announcement>
        ?? new List<EduConnect.Web.Models
            .Announcement>();
}

<div class="ec-hero mb-4">
    <div style="position:relative;z-index:1">
        <div class="ec-hero-sub small mb-1">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</div>
        <h3 class="fw-bold mb-1">Welcome back, @(Context.Session.GetString("UserName") ?? "Guest") 👋</h3>
        <div class="ec-hero-sub">Here's what's happening on campus today.</div>
    </div>
</div>

<!-- ─── PAGE HEADER ──────────────────── -->
<div class="d-flex justify-content-between
            align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-mortarboard
                       me-2 text-primary"></i>
            @dashboardLabel
        </h4>
        <small class="text-muted">
            @ViewBag.DepartmentName
            <span class="badge bg-primary ms-1">
                @ViewBag.DepartmentShort
            </span>
        </small>
    </div>
    <a href="/Announcement/Create"
       class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle me-1"></i>
        New Announcement
    </a>
</div>

<!-- ─── STAT CARDS ───────────────────── -->
<div class="row g-3 mb-4">

    <div class="col-6 col-md-4">
        <div class="card border-0 shadow-sm ec-lift">
            <div class="card-body text-center p-3">
                <div class="ec-stat-icon
                            bg-success bg-opacity-10
                            mx-auto mb-2">
                    <i class="bi bi-megaphone
                               text-success fs-5"></i>
                </div>
                <div class="fw-bold fs-4">
                    @ViewBag.TotalPublished
                </div>
                <div class="text-muted small">
                    Published
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-4">
        <div class="card border-0 shadow-sm ec-lift">
            <div class="card-body text-center p-3">
                <div class="ec-stat-icon
                            bg-primary bg-opacity-10
                            mx-auto mb-2">
                    <i class="bi bi-people
                               text-primary fs-5"></i>
                </div>
                <div class="fw-bold fs-4">
                    @ViewBag.TotalFaculty
                </div>
                <div class="text-muted small">
                    Faculty Members
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-4">
        <div class="card border-0 shadow-sm ec-lift">
            <div class="card-body text-center p-3">
                <div class="ec-stat-icon
                            bg-info bg-opacity-10
                            mx-auto mb-2">
                    <i class="bi bi-calendar-check
                               text-info fs-5"></i>
                </div>
                <div class="fw-bold fs-4">
                    @ViewBag.TodayAnnouncements
                </div>
                <div class="text-muted small">
                    Posted Today
                </div>
            </div>
        </div>
    </div>

</div>

<!-- ─── PENDING ANNOUNCEMENTS ────────── -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div id="pendingCard" aria-live="polite">
    <partial name="_PendingAnnouncements" model="pending" />
</div>

<!-- Review side panel: full width on phones, a column on wider screens -->
<div class="offcanvas offcanvas-end ec-review-panel" tabindex="-1"
     id="reviewPanel" aria-labelledby="reviewPanelTitle">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title fw-bold" id="reviewPanelTitle">
            <i class="bi bi-hourglass-split me-2 text-primary"></i>Review Announcement
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body bg-light">
        <div id="reviewPanelNotice" class="alert alert-warning d-none" role="alert"></div>
        <div id="reviewPanelBody"></div>
    </div>
</div>

<!-- ─── QUICK ACTIONS ─────────────────── -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-0 pt-3">
        <h6 class="fw-bold mb-0">
            <i class="bi bi-lightning
                       me-2 text-primary"></i>
            Quick Actions
        </h6>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-6 col-md-4">
                <a href="/Announcement/Create"
                   class="btn btn-outline-primary
                          w-100 py-3 text-center">
                    <i class="bi bi-plus-circle
                               d-block fs-3 mb-1"></i>
                    <small>New Announcement</small>
                </a>
            </div>
            <div class="col-6 col-md-4">
                <a href="/Announcement"
                   class="btn btn-outline-success
                          w-100 py-3 text-center">
                    <i class="bi bi-megaphone
                               d-block fs-3 mb-1"></i>
                    <small>All Announcements</small>
                </a>
            </div>
            <div class="col-6 col-md-4">
                <a href="/Event"
                   class="btn btn-outline-secondary
                          w-100 py-3 text-center">
                    <i class="bi bi-calendar-event
                               d-block fs-3 mb-1"></i>
                    <small>Events</small>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ─── RECENT ANNOUNCEMENTS ─────────── -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 pt-3">
        <h6 class="fw-bold mb-0">
            <i class="bi bi-table me-2 text-primary"></i>
            Recent Department Announcements
        </h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Title</th>
                        <th>Author</th>
                        <th>Category</th>
                        <th>Views</th>
                        <th>Status</th>
                        <th class="pe-3">Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!recentList.Any())
                    {
                        <tr>
                            <td colspan="6">
                                <div class="ec-empty">
                                    <i class="bi bi-inbox"></i>
                                    No announcements yet
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in recentList)
                        {
                            <tr>
                                <td class="ps-3 align-middle">
                                    <a href="/Announcement/Details/@item.AnnouncementID"
                                       class="text-decoration-none fw-semibold text-dark small">@item.Title</a>
                                </td>
                                <td class="align-middle small text-muted text-nowrap">
                                    @($"{item.Author?.FirstName} {item.Author?.LastName}")
                                </td>
                                <td class="align-middle">
                                    @if (item.Category != null)
                                    {
                                        <span class="badge rounded-pill" style="background-color:@item.Category.ColorHex">@item.Category.CategoryName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="align-middle small text-muted text-nowrap">
                                    <i class="bi bi-eye me-1"></i>@item.ViewCount
                                </td>
                                <td class="align-middle">
                                    <span class="badge @(item.Status == "Published" ? "bg-success" : "bg-secondary")">@item.Status</span>
                                </td>
                                <td class="align-middle small text-muted text-nowrap pe-3">
                                    @(item.PublishedAt?.ToString("MMM dd, yyyy") ?? "—")
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


@section Scripts {
<script>
    // Pending Announcements: "View" opens the review in a side panel so the
    // reviewer stays on the dashboard; Approve / Reject post as usual and
    // come back here. Live updates (ReviewQueueChanged over the shared
    // notification hub) refresh the list when anyone's action changes it.
    (function () {
        const panelEl = document.getElementById('reviewPanel');
        const panel   = new bootstrap.Offcanvas(panelEl);
        const body    = document.getElementById('reviewPanelBody');
        const notice  = document.getElementById('reviewPanelNotice');
        const card    = document.getElementById('pendingCard');
        const me      = document.body.dataset.userId;
        let openId = null;

        card.addEventListener('click', async e => {
            const link = e.target.closest('[data-review-open]');
            // Ctrl/Shift/middle click still opens the full page in a new tab.
            if (!link || e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return;
            e.preventDefault();

            const id = link.dataset.reviewOpen;
            openId = id;
            notice.classList.add('d-none');
            body.innerHTML = '<div class="text-center text-muted py-5">' +
                '<span class="spinner-border spinner-border-sm me-2"></span>Loading…</div>';
            panel.show();

            let html = null;
            try {
                const res = await fetch('/Announcement/ReviewPanel/' + encodeURIComponent(id) +
                    '?returnUrl=' + encodeURIComponent(location.pathname));
                if (res.ok) html = await res.text();
            } catch { /* shown below */ }
            if (openId !== id) return;   // closed, or another one opened meanwhile

            if (html === null) {
                body.replaceChildren();
                lockPanel('This announcement is no longer waiting for your review.');
                refreshList();
                return;
            }
            body.innerHTML = html;
        });

        panelEl.addEventListener('hidden.bs.offcanvas', () => {
            openId = null;
            body.replaceChildren();
        });

        async function refreshList() {
            try {
                const res = await fetch('/Dean/Pending');
                if (res.ok) card.innerHTML = await res.text();
            } catch { /* keep the list we have */ }
        }

        // Someone else decided: say who, and stop this reviewer acting on it.
        function lockPanel(message) {
            notice.textContent = message;
            notice.classList.remove('d-none');
            body.querySelectorAll('button, textarea, input[type=checkbox]')
                .forEach(el => el.disabled = true);
        }

        const verbs = {
            approved:  'approved',
            rejected:  'rejected',
            escalated: 'sent to the Dean'
        };

        if (window.ecHub) {
            window.ecHub.on('ReviewQueueChanged', e => {
                refreshList();
                if (openId === null || String(e.announcementId) !== openId || String(e.byUserId) === me)
                    return;
                if (e.change === 'withdrawn')
                    lockPanel('The author withdrew this announcement.');
                else if (verbs[e.change])
                    lockPanel((e.byName || 'Another reviewer') + ' just ' + verbs[e.change] + ' this announcement.');
            });
        }
    })();
</script>
}
