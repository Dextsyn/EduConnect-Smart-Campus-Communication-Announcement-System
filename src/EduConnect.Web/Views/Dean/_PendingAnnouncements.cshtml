@model EduConnect.Web.ViewModels.PendingAnnouncementsViewModel
@*
    The dashboard's Pending Announcements card. Rendered in the page and
    re-fetched from /Dean/Pending when a live update says the queue changed.
    "Review" opens the dashboard's side panel; the link still works alone.
*@
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-0 pt-3
                d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0">
            <i class="bi bi-hourglass-split me-2 text-primary"></i>
            Pending Announcements
            @if (Model.Count > 0)
            {
                <span class="badge bg-warning text-dark ms-1">@Model.Count</span>
            }
        </h6>
        @if (Model.Count > Model.Rows.Count)
        {
            <a href="/Announcement/ReviewQueue" class="btn btn-sm btn-outline-primary">
                View all
            </a>
        }
    </div>
    <div class="card-body p-0">
        @if (!Model.Rows.Any())
        {
            <div class="ec-empty">
                <i class="bi bi-check2-circle"></i>
                Nothing is waiting for your approval
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Title</th>
                            <th>Submitted by</th>
                            <th>Category</th>
                            <th>Submitted</th>
                            <th>Audience</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Rows)
                        {
                            <tr>
                                <td class="ps-3 align-middle fw-semibold small">@p.Title</td>
                                <td class="align-middle small text-muted">@p.AuthorName</td>
                                <td class="align-middle small">@(p.CategoryName ?? "—")</td>
                                <td class="align-middle small text-muted">
                                    @(p.SubmittedAt?.ToString("MMM dd, yyyy h:mm tt") ?? "—")
                                </td>
                                <td class="align-middle small text-muted">
                                    @(p.Audience.Any() ? string.Join(", ", p.Audience) : "—")
                                </td>
                                <td class="align-middle text-end pe-3">
                                    <a href="/Announcement/Review/@p.AnnouncementID"
                                       data-review-open="@p.AnnouncementID"
                                       class="btn btn-sm btn-outline-primary text-nowrap">
                                        <i class="bi bi-eye me-1"></i>View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
