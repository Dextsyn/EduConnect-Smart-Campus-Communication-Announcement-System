@{
    ViewData["Title"] = "Faculty Dashboard";
    var userName = Context.Session.GetString("UserName");
    var submissions = ViewBag.MySubmissions
        as List<EduConnect.Web.ViewModels.FacultySubmissionRow>
        ?? new List<EduConnect.Web.ViewModels.FacultySubmissionRow>();
    var myEventList =
        ViewBag.MyEventList as
        List<EduConnect.Web.Models.Event>
        ?? new List<EduConnect.Web.Models.Event>();
}

<div class="ec-hero mb-4">
    <div style="position:relative;z-index:1">
        <div class="ec-hero-sub small mb-1">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</div>
        <h3 class="fw-bold mb-1">Welcome back, @(Context.Session.GetString("UserName") ?? "Guest") 👋</h3>
        <div class="ec-hero-sub">Here's what's happening on campus today.</div>
    </div>
</div>

<!-- ─── PAGE HEADER ──────────────────── -->
<div class="d-flex justify-content-between
            align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-person-workspace
                       me-2 text-primary"></i>
            Faculty Dashboard
        </h4>
        <small class="text-muted">
            @ViewBag.DepartmentName
            <span class="badge bg-primary ms-1">
                @ViewBag.DepartmentShort
            </span>
        </small>
    </div>
    <a href="/Event/Create"
       class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle me-1"></i>
        New Event
    </a>
</div>

<!-- ─── STAT CARDS ───────────────────── -->
<div class="row g-3 mb-4">

    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm ec-lift">
            <div class="card-body text-center p-3">
                <div class="ec-stat-icon
                            bg-primary bg-opacity-10
                            mx-auto mb-2">
                    <i class="bi bi-calendar-event
                               text-primary fs-5"></i>
                </div>
                <div class="fw-bold fs-4">
                    @ViewBag.TotalEvents
                </div>
                <div class="text-muted small">
                    Total Events
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm ec-lift">
            <div class="card-body text-center p-3">
                <div class="ec-stat-icon
                            bg-success bg-opacity-10
                            mx-auto mb-2">
                    <i class="bi bi-calendar-check
                               text-success fs-5"></i>
                </div>
                <div class="fw-bold fs-4">
                    @ViewBag.UpcomingEvents
                </div>
                <div class="text-muted small">
                    Upcoming
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm ec-lift">
            <div class="card-body text-center p-3">
                <div class="ec-stat-icon
                            bg-secondary bg-opacity-10
                            mx-auto mb-2">
                    <i class="bi bi-check2-all
                               text-secondary fs-5"></i>
                </div>
                <div class="fw-bold fs-4">
                    @ViewBag.CompletedEvents
                </div>
                <div class="text-muted small">
                    Completed
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm ec-lift">
            <div class="card-body text-center p-3">
                <div class="ec-stat-icon
                            bg-info bg-opacity-10
                            mx-auto mb-2">
                    <i class="bi bi-people
                               text-info fs-5"></i>
                </div>
                <div class="fw-bold fs-4">
                    @ViewBag.TotalRegistrations
                </div>
                <div class="text-muted small">
                    Registrations
                </div>
            </div>
        </div>
    </div>

</div>

<!-- ─── MY SUBMISSIONS ────────────────── -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-0 pt-3
                d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0">
            <i class="bi bi-send-check me-2 text-primary"></i>
            My Submissions
        </h6>
        <a href="/Announcement/MyAnnouncements"
           class="btn btn-sm btn-outline-primary">
            My Announcements
        </a>
    </div>
    <div class="card-body p-0">
        @if (!submissions.Any())
        {
            <div class="ec-empty">
                <i class="bi bi-check2-circle"></i>
                No announcements awaiting review or action
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Title</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in submissions)
                        {
                            <tr>
                                <td class="ps-3 align-middle fw-semibold small">@s.Title</td>
                                <td class="align-middle">
                                    @switch (s.ApprovalStatus)
                                    {
                                        case "PendingChair":
                                            <span class="ec-chip ec-chip-gold">Awaiting Chairperson</span>
                                            break;
                                        case "PendingDean":
                                            <span class="ec-chip ec-chip-gold">Awaiting Dean</span>
                                            break;
                                        case "Rejected":
                                            <span class="badge text-bg-danger">Rejected</span>
                                            break;
                                        case "Approved":
                                            <span class="badge text-bg-success">Approved — ready to publish</span>
                                            break;
                                    }
                                    @if (s.ApprovalStatus == "Rejected" &&
                                         !string.IsNullOrEmpty(s.RejectionReason))
                                    {
                                        <div class="small text-danger mt-1">
                                            <i class="bi bi-x-circle me-1"></i>@s.RejectionReason
                                        </div>
                                    }
                                </td>
                                <td class="align-middle small text-muted">
                                    @(s.SubmittedAt?.ToString("MMM dd, yyyy") ?? "—")
                                </td>
                                <td class="align-middle text-end pe-3">
                                    @if (s.ApprovalStatus == "Rejected")
                                    {
                                        <a href="/Announcement/Edit/@s.AnnouncementID"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </a>
                                    }
                                    else if (s.ApprovalStatus == "Approved")
                                    {
                                        <form method="post"
                                              action="/Announcement/Publish/@s.AnnouncementID"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-globe me-1"></i>Publish
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- ─── MY EVENTS TABLE ───────────────── -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 pt-3
                d-flex justify-content-between
                align-items-center">
        <h6 class="fw-bold mb-0">
            <i class="bi bi-list-ul
                       me-2 text-primary"></i>
            My Events
        </h6>
        <a href="/Event/Create"
           class="btn btn-primary btn-sm">
            <i class="bi bi-plus me-1"></i>
            New
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Event</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Registrants</th>
                        <th>Turnout</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!myEventList.Any())
                    {
                        <tr>
                            <td colspan="7">
                                <div class="ec-empty">
                                    <i class="bi bi-calendar-event"></i>
                                    No events yet.
                                    <a href="/Event/Create"
                                       class="text-primary">
                                        Create your first event.
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ev in myEventList)
                        {
                            var registeredCount = ev.Registrations
                                ?.Count(r => r.Status != "Cancelled")
                                ?? 0;
                            var attendedCount = ev.Registrations
                                ?.Count(r => r.Status == "Attended")
                                ?? 0;
                            var ended = ev.EndDateTime < DateTime.Now;
                            var regClosed = !ev.IsRegistrationOpen ||
                                (ev.RegistrationDeadline.HasValue &&
                                 ev.RegistrationDeadline.Value < DateTime.Now);
                            var isFull = ev.MaxAttendees.HasValue &&
                                registeredCount >= ev.MaxAttendees.Value;
                            <tr>
                                <td class="ps-3">
                                    <a href="/Event/Details/@ev.EventID"
                                       class="text-decoration-none
                                              fw-semibold text-dark small">
                                        @ev.EventTitle
                                    </a>
                                </td>
                                <td class="small text-muted">
                                    @ev.StartDateTime.ToString("MMM dd, yyyy")
                                </td>
                                <td class="small text-muted">
                                    @(string.IsNullOrEmpty(ev.Location)
                                        ? (ev.IsOnline ? "Online" : "—")
                                        : ev.Location)
                                </td>
                                <td class="small text-muted">
                                    <i class="bi bi-people me-1"></i>
                                    @registeredCount
                                    @if (ev.MaxAttendees.HasValue)
                                    {
                                        <span>/ @ev.MaxAttendees</span>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @if (ev.Status == "Cancelled")
                                    {
                                        <span>—</span>
                                    }
                                    else if (ended)
                                    {
                                        <span>
                                            <i class="bi bi-person-check me-1"></i>@attendedCount attended
                                            @if (registeredCount > 0)
                                            {
                                                <span>· @(attendedCount * 100 / registeredCount)%</span>
                                            }
                                        </span>
                                    }
                                    else if (regClosed)
                                    {
                                        <span>Registration closed</span>
                                    }
                                    else if (isFull)
                                    {
                                        <span class="text-warning">Full</span>
                                    }
                                    else if (ev.RegistrationDeadline.HasValue)
                                    {
                                        <span>Closes @ev.RegistrationDeadline.Value.ToString("MMM dd, h:mm tt")</span>
                                    }
                                    else
                                    {
                                        <span>Open</span>
                                    }
                                </td>
                                <td>
                                    @switch (ev.Status)
                                    {
                                        case "Upcoming":
                                            <span class="badge bg-primary">
                                                Upcoming
                                            </span>
                                            break;
                                        case "Ongoing":
                                            <span class="badge bg-success">
                                                Ongoing
                                            </span>
                                            break;
                                        case "Completed":
                                            <span class="badge bg-secondary">
                                                Completed
                                            </span>
                                            break;
                                        case "Cancelled":
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">
                                                @ev.Status
                                            </span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <a href="/Event/Registrants/@ev.EventID"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-people-fill"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
