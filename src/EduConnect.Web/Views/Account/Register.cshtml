@model EduConnect.Web.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <title>Register — EduConnect</title>
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="ec-auth">
        <div class="ec-auth-panel">
            <div style="position:relative;z-index:1">
                <i class="bi bi-broadcast" style="font-size:2.5rem;color:var(--ec-gold)"></i>
                <h1 class="fw-bold mt-3" style="letter-spacing:-.02em">EduConnect</h1>
                <p class="fs-5" style="color:rgba(255,255,255,.8)">
                    Adamson University's smart campus communication system —
                    announcements, events, and organizations in one place.
                </p>
                <div class="d-flex flex-column gap-2 mt-4" style="color:rgba(255,255,255,.85)">
                    <div><i class="bi bi-megaphone me-2" style="color:var(--ec-gold)"></i> Campus announcements in real time</div>
                    <div><i class="bi bi-calendar-event me-2" style="color:var(--ec-gold)"></i> Event registration with QR check-in</div>
                    <div><i class="bi bi-people me-2" style="color:var(--ec-gold)"></i> Organizations and group finder</div>
                </div>
            </div>
        </div>
        <div class="ec-auth-form">
            <div class="card p-4 p-md-5">
                <div class="text-center mb-4 d-lg-none">
                    <div class="ec-auth-logo mx-auto mb-3"><i class="bi bi-broadcast text-white fs-3"></i></div>
                    <h4 class="fw-bold mb-0">EduConnect</h4>
                    <small class="text-muted">Smart Campus Communication System</small>
                </div>
                <h4 class="fw-bold d-none d-lg-block mb-1">Create your account</h4>
                <p class="text-muted d-none d-lg-block mb-4">Join the campus community</p>

                    <!-- Validation Summary -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-circle me-2"></i>
                            Please fix the errors below.
                        </div>
                    }

                    <!-- Register Form -->
                    <form asp-action="Register" method="post" id="registerForm">
                        @Html.AntiForgeryToken()

                        <!-- Name Row -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName"
                                       class="form-label fw-semibold">
                                    First Name
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-person"></i>
                                    </span>
                                    <input asp-for="FirstName"
                                           class="form-control"
                                           placeholder="Juan" />
                                </div>
                                <span asp-validation-for="FirstName"
                                      class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName"
                                       class="form-label fw-semibold">
                                    Last Name
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-person"></i>
                                    </span>
                                    <input asp-for="LastName"
                                           class="form-control"
                                           placeholder="Dela Cruz" />
                                </div>
                                <span asp-validation-for="LastName"
                                      class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Suffix + Student Number -->
                        <div class="row g-3 mb-3">
                            <div class="col-4">
                                <label asp-for="Suffix"
                                       class="form-label fw-semibold">
                                    Suffix
                                </label>
                                <select asp-for="Suffix" class="form-select">
                                    <option value="">None</option>
                                    @foreach (var suffix in PersonInput.Suffixes)
                                    {
                                        <option value="@suffix">@suffix</option>
                                    }
                                </select>
                                <span asp-validation-for="Suffix"
                                      class="text-danger small"></span>
                            </div>
                            <div class="col-8">
                                <label asp-for="StudentID"
                                       class="form-label fw-semibold">
                                    Student Number
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-card-text"></i>
                                    </span>
                                    <input asp-for="StudentID"
                                           class="form-control"
                                           inputmode="numeric"
                                           autocomplete="off"
                                           maxlength="9"
                                           placeholder="e.g. 202312345" />
                                </div>
                                <span asp-validation-for="StudentID"
                                      class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Add after Student ID field -->
                        <!--
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                School ID Photo
                                <span class="text-danger">*</span>
                            </label>
                            <input type="file"
                                   name="SchoolIDPhoto"
                                   class="form-control"
                                   accept="image/*"
                                   required />
                            <div class="form-text text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                Upload a clear photo of your Adamson
                                University School ID for verification.
                                ITC will verify your account within
                                1-2 business days.
                            </div>
                        </div>
                        -->
                        
                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="EmailUser"
                                   class="form-label fw-semibold">
                                Adamson Email Address
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input asp-for="EmailUser"
                                       id="emailUser"
                                       class="form-control"
                                       placeholder="juan.delacruz"
                                       autocomplete="username"
                                       autocapitalize="off"
                                       spellcheck="false" />
                                <span class="input-group-text">@EduConnect.Web.ViewModels.RegisterViewModel.EmailDomain</span>
                            </div>
                            <span asp-validation-for="EmailUser"
                                  class="text-danger small"></span>
                            <div class="form-text">Use your Adamson account; other email providers can't be used.</div>
                        </div>

                        <!-- Program -->
                        <div class="mb-3 row g-0">
                            @await Html.PartialAsync("_PlacementFields", Model)
                        </div>

                        <!-- Password -->
                        <div class="mb-3">
                            <label asp-for="Password"
                                   class="form-label fw-semibold">
                                Password
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input asp-for="Password"
                                       class="form-control"
                                       id="passwordField"
                                       data-password-rule
                                       aria-describedby="passwordHint"
                                       placeholder="Minimum 8 characters" />
                                <button class="btn btn-outline-secondary"
                                        type="button"
                                        onclick="togglePassword('passwordField', 'eyeIcon1')">
                                    <i class="bi bi-eye" id="eyeIcon1"></i>
                                </button>
                            </div>
                            <div id="passwordHint" class="form-text">@PersonInput.PasswordHint</div>
                            <span asp-validation-for="Password"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Confirm Password -->
                        <div class="mb-4">
                            <label asp-for="ConfirmPassword"
                                   class="form-label fw-semibold">
                                Confirm Password
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-lock-fill"></i>
                                </span>
                                <input asp-for="ConfirmPassword"
                                       class="form-control"
                                       id="confirmField"
                                       placeholder="Re-enter your password" />
                                <button class="btn btn-outline-secondary"
                                        type="button"
                                        onclick="togglePassword('confirmField', 'eyeIcon2')">
                                    <i class="bi bi-eye" id="eyeIcon2"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Password Strength -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between mb-1">
                                <small class="text-muted">
                                    Password strength
                                </small>
                                <small id="strengthText"
                                       class="text-muted">
                                    —
                                </small>
                            </div>
                            <div class="progress" style="height: 4px;">
                                <div class="progress-bar"
                                     id="strengthBar"
                                     style="width: 0%">
                                </div>
                            </div>
                        </div>

                        <!-- Submit -->
                        <button type="submit"
                                class="btn btn-primary w-100 py-2 fw-semibold">
                            <i class="bi bi-person-plus me-2"></i>
                            Create Account
                        </button>

                    </form>

                    <!-- Login Link -->
                    <div class="text-center mt-4">
                        <small class="text-muted">
                            Already have an account?
                            <a href="/Account/Login"
                               class="text-primary fw-semibold">
                                Login here
                            </a>
                        </small>
                    </div>

                <!-- Footer -->
                <div class="text-center mt-3">
                    <small class="text-muted">
                        &copy; 2026 Adamson University — EduConnect
                    </small>
                </div>

            </div>
        </div>
    </div>

    <!-- Review before submitting: the program can't be changed later
         except by ITC, so the student checks everything once. -->
    <div class="modal fade" id="reviewModal" tabindex="-1"
         aria-labelledby="reviewModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="reviewModalTitle">
                        <i class="bi bi-clipboard-check me-2 text-primary"></i>
                        Is everything correct?
                    </h5>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <dl class="row mb-3 small">
                        <dt class="col-5 col-sm-4 text-muted fw-normal">Name</dt>
                        <dd class="col-7 col-sm-8 fw-semibold text-break" data-review="name"></dd>
                        <dt class="col-5 col-sm-4 text-muted fw-normal">Student number</dt>
                        <dd class="col-7 col-sm-8 fw-semibold" data-review="studentId"></dd>
                        <dt class="col-5 col-sm-4 text-muted fw-normal">Email</dt>
                        <dd class="col-7 col-sm-8 fw-semibold text-break" data-review="email"></dd>
                        <dt class="col-5 col-sm-4 text-muted fw-normal">College</dt>
                        <dd class="col-7 col-sm-8 fw-semibold" data-review="college"></dd>
                        <dt class="col-5 col-sm-4 text-muted fw-normal" data-review-row="department">Department</dt>
                        <dd class="col-7 col-sm-8 fw-semibold" data-review="department"></dd>
                        <dt class="col-5 col-sm-4 text-muted fw-normal">Program</dt>
                        <dd class="col-7 col-sm-8 fw-semibold mb-0" data-review="program"></dd>
                    </dl>
                    <div class="alert alert-warning small mb-0">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Your program decides which announcements and events you see.
                        <strong>You can't change it yourself after registering</strong>;
                        only ITC can.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        <i class="bi bi-pencil me-1"></i>
                        Go back and edit
                    </button>
                    <button type="button" class="btn btn-primary" id="reviewConfirm">
                        <i class="bi bi-check-circle me-1"></i>
                        Yes, submit
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>
    <script>
        // Show what will be submitted and let the student confirm it. Only
        // a form the browser accepts gets the pop-up; anything the server
        // still has to report (no program, passwords that differ) submits
        // straight away so its errors show as usual.
        (function () {
            const form = document.getElementById('registerForm');
            const modalEl = document.getElementById('reviewModal');
            const modal = new bootstrap.Modal(modalEl);
            const confirmBtn = document.getElementById('reviewConfirm');
            const domain = '@EduConnect.Web.ViewModels.RegisterViewModel.EmailDomain';
            const val = id => document.getElementById(id).value.trim();
            const chosen = id => {
                const s = document.getElementById(id);
                return s.value ? s.options[s.selectedIndex].text.trim() : '';
            };
            const set = (key, text) =>
                modalEl.querySelector('[data-review="' + key + '"]').textContent = text;
            let confirmed = false;

            form.addEventListener('submit', function (e) {
                if (confirmed) return;
                if (!form.checkValidity() || !val('ProgramID') ||
                    val('passwordField') !== val('confirmField')) return;

                e.preventDefault();
                const name = [val('FirstName'), val('LastName'), val('Suffix')]
                    .filter(Boolean).join(' ').replace(/\s+/g, ' ');
                const department = chosen('DepartmentID');
                set('name', name);
                set('studentId', val('StudentID'));
                set('email', val('emailUser').toLowerCase() + domain);
                set('college', chosen('CollegeID'));
                set('department', department);
                set('program', chosen('ProgramID'));
                // Colleges without departments have nothing to show here.
                for (const el of modalEl.querySelectorAll('[data-review-row="department"], [data-review="department"]'))
                    el.hidden = !department;
                modal.show();
            });

            confirmBtn.addEventListener('click', function () {
                confirmed = true;
                confirmBtn.disabled = true;
                form.submit();
            });
        })();
    </script>
    <script>
        // The domain is fixed: a pasted full Adamson address is trimmed to
        // the part before it; any other "@@" (e.g. @@gmail.com) is refused.
        (function () {
            const input = document.getElementById('emailUser');
            const domain = '@EduConnect.Web.ViewModels.RegisterViewModel.EmailDomain';
            const pattern = /^[A-Za-z0-9]+([._-][A-Za-z0-9]+)*$/;
            function check() {
                let v = input.value.trim();
                if (v.toLowerCase().endsWith(domain)) {
                    v = v.slice(0, -domain.length);
                    input.value = v;
                }
                input.setCustomValidity(
                    !v ? '' :
                    v.includes("@@") ? 'Only Adamson accounts can register. Type just the part before ' + domain + '.' :
                    !pattern.test(v) ? 'Use only letters, numbers, dots, dashes or underscores.' : '');
            }
            input.addEventListener('input', check);
            input.addEventListener('change', check);
            check();
        })();

        // Same rules as the server (PersonInput). This page doesn't load
        // jQuery Validation, so the browser's own validity check blocks the
        // submit.
        (function () {
            const input = document.getElementById('StudentID');
            const re = new RegExp(@Json.Serialize(PersonInput.StudentNumberPattern));
            const check = () => {
                const v = input.value.trim();
                input.setCustomValidity(v && !re.test(v) ? @Json.Serialize(PersonInput.StudentNumberError) : '');
            };
            input.addEventListener('input', check);
            check();
        })();

        // First and last name ([PersonName]): the problem shows in red under
        // the box as soon as it is typed, and on submit under every name
        // that is wrong, instead of the browser's bubble on the first one.
        (function () {
            const form = document.getElementById('registerForm');
            const re = new RegExp(@Json.Serialize(PersonInput.NamePattern));
            const letters = @Json.Serialize(PersonInput.NameError);
            const digits = @Json.Serialize(PersonInput.NameDigitsError);
            const names = ['FirstName', 'LastName'].map(id => document.getElementById(id));
            const messageFor = input =>
                form.querySelector('[data-valmsg-for="' + input.name + '"]');

            const problem = input => {
                const v = input.value.trim().replace(/\s+/g, ' ');
                if (!v) return '';
                if (/[0-9]/.test(v)) return digits;
                return re.test(v) ? '' : letters;
            };
            const show = (input, text) => {
                messageFor(input).textContent = text;
                input.classList.toggle('is-invalid', !!text);
            };

            for (const input of names) {
                // A server error on the field (after a post) shows in red too.
                if (messageFor(input).textContent.trim()) input.classList.add('is-invalid');

                input.addEventListener('input', function () {
                    const text = problem(input);
                    input.setCustomValidity(text);
                    show(input, text);
                });
                input.addEventListener('invalid', function (e) {
                    e.preventDefault();   // no bubble; the red text says it
                    show(input, problem(input));
                    // The browser only scrolls to a field whose bubble it
                    // shows, so bring the first wrong field into view here.
                    const first = Array.from(form.elements).find(el => el.willValidate && !el.validity.valid);
                    if (first === input) {
                        input.scrollIntoView({ block: 'center' });
                        input.focus({ preventScroll: true });
                    }
                });
                input.setCustomValidity(problem(input));
            }
        })();

        // Toggle password visibility
        function togglePassword(fieldId, iconId) {
            const field = document.getElementById(fieldId);
            const icon = document.getElementById(iconId);
            if (field.type === 'password') {
                field.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                field.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }

        // Password strength checker
        document.getElementById('passwordField')
            .addEventListener('input', function () {
            const val = this.value;
            const bar = document.getElementById('strengthBar');
            const text = document.getElementById('strengthText');

            let strength = 0;
            if (val.length >= 8) strength++;
            if (/[A-Z]/.test(val) && /[a-z]/.test(val)) strength++;
            if (/[0-9]/.test(val)) strength++;
            if (/[^A-Za-z0-9]/.test(val)) strength++;

            const levels = [
                { width: '0%',   color: '',          label: '—' },
                { width: '25%',  color: 'bg-danger',  label: 'Weak' },
                { width: '50%',  color: 'bg-warning', label: 'Fair' },
                { width: '75%',  color: 'bg-info',    label: 'Good' },
                { width: '100%', color: 'bg-success',  label: 'Strong' }
            ];

            bar.style.width = levels[strength].width;
            bar.className = 'progress-bar ' + levels[strength].color;
            text.textContent = levels[strength].label;
            text.className = levels[strength].color
                .replace('bg-', 'text-');
        });
    </script>
    <partial name="_PasswordRule" />
</body>
</html>