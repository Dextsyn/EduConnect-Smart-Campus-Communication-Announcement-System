@model List<EduConnect.Web.Models.IncidentReport>
@{
    ViewData["Title"] = "My Safety Reports";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-shield-check me-2 text-primary"></i>
            My Safety Reports
        </h4>
        <small class="text-muted">
            Track what campus staff have done with the reports you submitted.
        </small>
    </div>
    <a href="/SafetyReport/Submit" class="btn btn-warning btn-sm">
        <i class="bi bi-plus-circle me-1"></i>New Report
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="ec-empty">
            <i class="bi bi-inbox"></i>
            You haven't submitted any safety reports yet
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var r in Model)
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <div class="fw-semibold">
                                    #@r.ReportID · @r.IncidentType
                                </div>
                                <div class="text-muted small">
                                    @(string.IsNullOrWhiteSpace(r.Location) ? "No specific location" : r.Location)
                                    · Submitted @r.ReportedAt.ToString("MMM dd, yyyy h:mm tt")
                                </div>
                            </div>
                            <partial name="_ReportStatusChip" model="r.Status" />
                        </div>

                        <p class="small mb-2 text-break">@r.Description</p>

                        @if (!string.IsNullOrWhiteSpace(r.Resolution))
                        {
                            <div class="p-3 bg-light rounded small">
                                <div class="fw-semibold mb-1">
                                    <i class="bi bi-chat-left-text me-1 text-primary"></i>
                                    Note from campus staff
                                </div>
                                <div class="text-break">@r.Resolution</div>
                            </div>
                        }

                        @if (r.ResolvedAt.HasValue)
                        {
                            <div class="text-muted small mt-2">
                                Closed @r.ResolvedAt.Value.ToString("MMM dd, yyyy h:mm tt")
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
