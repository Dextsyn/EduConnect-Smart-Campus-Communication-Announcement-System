@model EduConnect.Web.Models.ReportingSanction
@{
    ViewData["Title"] = "Safety Reports Suspended";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5 text-center">
                <i class="bi bi-slash-circle text-danger display-5"></i>
                <h4 class="fw-bold mt-3 mb-2">You can't file safety reports right now</h4>
                <p class="text-muted mb-4">
                    Your access to Safety Reports is suspended until
                    <strong class="text-body">@Model.EndsAt?.ToString("dddd, MMMM d, yyyy 'at' h:mm tt")</strong>,
                    because campus staff found that safety report #@Model.ReportID was a false report.
                </p>

                <div class="text-start p-3 bg-light rounded small mb-4">
                    <div class="fw-semibold mb-1">What staff found</div>
                    <div class="text-break" style="white-space: pre-line;">@Model.Reason</div>
                </div>

                <p class="small text-muted mb-4">
                    You can still follow every report you've already filed. If you believe this
                    decision is a mistake, you can appeal it once from My Safety Reports.
                </p>

                <a href="/SafetyReport/MyReports" class="btn btn-primary">
                    <i class="bi bi-shield-check me-2"></i>My Safety Reports
                </a>
            </div>
        </div>
    </div>
</div>
