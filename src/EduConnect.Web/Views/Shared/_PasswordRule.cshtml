@*
    The password rule (PersonInput.PasswordPattern) in the browser, for any
    <input data-password-rule> on pages without jQuery Validation. Render it
    after the inputs. The server applies the same rule regardless.
*@
<script>
    (function () {
        const rule = new RegExp(@Json.Serialize(PersonInput.PasswordPattern));
        const message = @Json.Serialize(PersonInput.PasswordError);
        document.querySelectorAll('input[data-password-rule]').forEach(input => {
            const check = () => input.setCustomValidity(
                input.value && !rule.test(input.value) ? message : '');
            input.addEventListener('input', check);
            check();
        });
    })();
</script>
