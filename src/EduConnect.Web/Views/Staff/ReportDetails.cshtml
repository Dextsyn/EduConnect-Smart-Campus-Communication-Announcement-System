@model EduConnect.Web.Models.IncidentReport
@{
    ViewData["Title"] = $"Report #{Model.ReportID}";
    var isFalse = Model.Status == EduConnect.Web.Models.IncidentReport.FalseReport;
    var preview = ViewBag.FalseReportPreview as EduConnect.Web.Services.FalseReportPreview;
    var sanction = ViewBag.Sanction as EduConnect.Web.Models.ReportingSanction;
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-file-earmark-text me-2 text-warning"></i>
            Report #@Model.ReportID
        </h4>
        <small class="text-muted">
            <span class="badge bg-secondary me-1">@Model.IncidentType</span>
            <partial name="_ReportStatusChip" model="Model.Status" />
        </small>
    </div>
    <a href="/Staff" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-2"></i>Back to Reports
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">

    <!-- Left: Report Details -->
    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">

                <h6 class="text-muted text-uppercase fw-bold mb-3 small">
                    Report Details
                </h6>

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted small">Building</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-secondary">@Model.IncidentType</span>
                    </dd>

                    <dt class="col-sm-4 text-muted small">Specific Location</dt>
                    <dd class="col-sm-8 small">
                        @(string.IsNullOrWhiteSpace(Model.Location)
                            ? "Not specified"
                            : Model.Location)
                    </dd>

                    <dt class="col-sm-4 text-muted small">Reporter</dt>
                    <dd class="col-sm-8 small">
                        @(Model.ReportedBy != null
                                ? $"{Model.ReportedBy.FirstName} {Model.ReportedBy.LastName}"
                                : "—")
                    </dd>

                    <dt class="col-sm-4 text-muted small">Submitted</dt>
                    <dd class="col-sm-8 small">
                        @Model.ReportedAt.ToString("MMM dd, yyyy h:mm tt")
                    </dd>

                    @if (Model.ResolvedAt.HasValue)
                    {
                        <dt class="col-sm-4 text-muted small">Resolved / Dismissed</dt>
                        <dd class="col-sm-8 small">
                            @Model.ResolvedAt.Value.ToString("MMM dd, yyyy h:mm tt")
                        </dd>
                    }

                    @if (Model.HandledBy != null)
                    {
                        <dt class="col-sm-4 text-muted small">Handled By</dt>
                        <dd class="col-sm-8 small">
                            @Model.HandledBy.FirstName @Model.HandledBy.LastName
                        </dd>
                    }
                </dl>

                <hr class="my-3" />

                <h6 class="text-muted text-uppercase fw-bold mb-2 small">
                    Description
                </h6>
                <p class="mb-0" style="white-space:pre-wrap">@Model.Description</p>

                @if (!string.IsNullOrWhiteSpace(Model.Resolution))
                {
                    <hr class="my-3" />
                    <h6 class="text-muted text-uppercase fw-bold mb-2 small">
                        Resolution Note
                    </h6>
                    <p class="mb-0 text-success" style="white-space:pre-wrap">
                        @Model.Resolution
                    </p>
                }

            </div>
        </div>
    </div>

    <!-- Right: Photo + Update Form -->
    <div class="col-12 col-lg-5">

        @if (!string.IsNullOrEmpty(Model.PhotoURL))
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3">
                    <h6 class="text-muted text-uppercase fw-bold mb-2 small">
                        Photo
                    </h6>
                    <img src="@Model.PhotoURL"
                         alt="Incident photo"
                         class="img-fluid rounded"
                         style="max-height:300px;object-fit:cover;width:100%" />
                </div>
            </div>
        }

        @if (isFalse)
        {
            <div class="card border-0 shadow-sm border-start border-danger border-4">
                <div class="card-body p-4">
                    <h6 class="text-danger text-uppercase fw-bold mb-2 small">
                        <i class="bi bi-flag-fill me-1"></i>Marked as a false report
                    </h6>
                    @if (sanction != null)
                    {
                        <p class="small mb-2">
                            <strong>@(sanction.Type == EduConnect.Web.Models.ReportingSanction.Warning
                                ? "Warning"
                                : $"Suspended until {sanction.EndsAt:MMM dd, yyyy h:mm tt}")</strong>
                            · strike @sanction.Strike in 12 months
                            @if (sanction.ReferredToOsa)
                            {
                                <span class="badge text-bg-danger ms-1">Refer to OSA</span>
                            }
                        </p>
                        <p class="small text-muted mb-2">Issued by @(sanction.IssuedByName ?? "—") on @sanction.IssuedAt.ToString("MMM dd, yyyy h:mm tt")</p>
                    }
                    else
                    {
                        <p class="small text-muted mb-2">No warning or suspension was given (the reporter isn't a student, or the report was filed anonymously).</p>
                    }
                    <p class="small mb-0">
                        Only an Administrator can reverse this, from
                        <a href="/Staff/Sanctions">Report Sanctions</a>.
                    </p>
                </div>
            </div>
        }
        else
        {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h6 class="text-muted text-uppercase fw-bold mb-3 small">
                    Update Status
                </h6>

                <form asp-action="UpdateStatus"
                      asp-route-id="@Model.ReportID"
                      method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Status</label>
                        <select name="status" class="form-select">
                            <option value="Pending" selected="@(Model.Status == "Pending" ? "selected" : null)">
                                Pending
                            </option>
                            <option value="Investigating" selected="@(Model.Status == "Investigating" ? "selected" : null)">
                                Investigating
                            </option>
                            <option value="Resolved" selected="@(Model.Status == "Resolved" ? "selected" : null)">
                                Resolved
                            </option>
                            <option value="Dismissed" selected="@(Model.Status == "Dismissed" ? "selected" : null)">
                                Dismissed
                            </option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">
                            Resolution Note
                        </label>
                        <textarea name="resolution"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Describe what was done or why it was dismissed...">@Model.Resolution</textarea>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary fw-semibold">
                            <i class="bi bi-check2 me-2"></i>Save Update
                        </button>
                    </div>

                </form>
            </div>
        </div>
        }

        @if (preview?.CanMark == true)
        {
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-body p-4">
                    <h6 class="text-danger text-uppercase fw-bold mb-2 small">
                        <i class="bi bi-flag me-1"></i>Mark as false report
                    </h6>
                    <p class="small text-muted mb-2">
                        Only for a report filed <strong>knowingly</strong> false, not one that
                        was mistaken or made in good faith.
                    </p>
                    <div class="alert @(preview.Sanctions ? "alert-warning" : "alert-secondary") small py-2">
                        @preview.Summary
                    </div>
                    <form asp-action="MarkFalse" asp-route-id="@Model.ReportID" method="post"
                          onsubmit="return confirm('Mark report #@Model.ReportID as a false report? @(preview.Sanctions ? "The reporter will be sanctioned and notified." : "The reporter will be notified.")');">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="falseReason" class="form-label fw-semibold small">
                                Why is it false? <span class="text-danger">*</span>
                            </label>
                            <textarea id="falseReason" name="reason" class="form-control" rows="3" required
                                      placeholder="What staff found. The reporter will see this."></textarea>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-outline-danger fw-semibold">
                                <i class="bi bi-flag me-2"></i>Mark as False Report
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }

    </div>
</div>

<!-- History -->
<div class="card border-0 shadow-sm mt-4" id="history">
    <div class="card-body p-4">
        <h6 class="text-muted text-uppercase fw-bold mb-3 small">
            <i class="bi bi-clock-history me-1"></i>History
        </h6>

        @if (!Model.Activities.Any())
        {
            <p class="text-muted small mb-0">No recorded activity yet.</p>
        }
        else
        {
            <ul class="list-unstyled mb-0">
                @foreach (var a in Model.Activities
                    .OrderBy(a => a.CreatedAt).ThenBy(a => a.ActivityID))
                {
                    <li class="border-start border-3 ps-3 pb-3
                               @(a.Action == EduConnect.Web.Models.IncidentReportActivity.Received
                                   ? "border-primary" : "border-warning")">
                        <div class="small text-muted">
                            @a.CreatedAt.ToString("MMM dd, yyyy h:mm tt")
                            ·
                            @(a.DisplayActorName ?? "—")
                        </div>
                        <div class="fw-semibold">@a.Summary</div>
                        @if (!string.IsNullOrWhiteSpace(a.Note))
                        {
                            <div class="small" style="white-space:pre-wrap">@a.Note</div>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</div>
