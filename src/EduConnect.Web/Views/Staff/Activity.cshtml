@model EduConnect.Web.ViewModels.StaffActivityViewModel
@using EduConnect.Web.Models
@using EduConnect.Web.ViewModels
@{
    ViewData["Title"] = "Activity Log";
    var f = Model.Filter;
    var buildings = new[] { "SV", "ST", "OZ", "CS", "CT", "Other" };
    var statuses = new[] { "Pending", "Investigating", "Resolved", "Dismissed" };

    // Same filters, different scope or page.
    Dictionary<string, string> Route(string scope, int page)
    {
        var route = new Dictionary<string, string>
        {
            ["scope"] = scope,
            ["page"] = page.ToString()
        };
        if (f.From.HasValue) route["from"] = f.From.Value.ToString("yyyy-MM-dd");
        if (f.To.HasValue) route["to"] = f.To.Value.ToString("yyyy-MM-dd");
        if (!string.IsNullOrEmpty(f.Status)) route["status"] = f.Status;
        if (!string.IsNullOrEmpty(f.Building)) route["building"] = f.Building;
        return route;
    }
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-clock-history me-2 text-warning"></i>
            Activity Log
        </h4>
        <small class="text-muted">
            A permanent record of the safety reports received and the work done on them.
        </small>
    </div>
</div>

<!-- Scope -->
<ul class="nav nav-pills mb-3">
    <li class="nav-item">
        <a class="nav-link @(f.IsAll ? "" : "active")"
           asp-action="Activity" asp-all-route-data="@Route(StaffActivityFilterViewModel.Mine, 1)">
            <i class="bi bi-person me-1"></i>My Work
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(f.IsAll ? "active" : "")"
           asp-action="Activity" asp-all-route-data="@Route(StaffActivityFilterViewModel.All, 1)">
            <i class="bi bi-people me-1"></i>All Activity
        </a>
    </li>
</ul>

<!-- Summary -->
<div class="row g-3 mb-4">
    @foreach (var (icon, tint, count, label) in new[]
    {
        ("bi-inbox", "primary", Model.ReceivedCount, "Reports Received"),
        ("bi-check2-circle", "success", Model.ResolvedCount, "Resolved"),
        ("bi-x-circle", "secondary", Model.DismissedCount, "Dismissed"),
        ("bi-pencil-square", "warning", Model.ActionCount, f.IsAll ? "Actions Taken" : "My Actions")
    })
    {
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-3">
                    <div class="ec-stat-icon bg-@tint bg-opacity-10 mx-auto mb-2">
                        <i class="bi @icon text-@tint fs-5"></i>
                    </div>
                    <div class="fw-bold fs-4">@count</div>
                    <div class="text-muted small">@label</div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Activity" class="row g-2 align-items-end">
            <input type="hidden" name="Scope" value="@f.Scope" />
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold mb-1">From</label>
                <input type="date" name="From" class="form-control form-control-sm"
                       value="@f.From?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold mb-1">To</label>
                <input type="date" name="To" class="form-control form-control-sm"
                       value="@f.To?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small fw-semibold mb-1">Status</label>
                <select name="Status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (var s in statuses)
                    {
                        <option value="@s" selected="@(f.Status == s ? "selected" : null)">@s</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small fw-semibold mb-1">Building</label>
                <select name="Building" class="form-select form-select-sm">
                    <option value="">All Buildings</option>
                    @foreach (var b in buildings)
                    {
                        <option value="@b" selected="@(f.Building == b ? "selected" : null)">@b</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Log -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Rows.Any())
        {
            <div class="ec-empty">
                <i class="bi bi-inbox"></i>
                No activity matches the current filters.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">When</th>
                            <th>Report</th>
                            <th>Building</th>
                            <th>Action</th>
                            <th>By</th>
                            <th>Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.Rows)
                        {
                            <tr>
                                <td class="ps-4 small text-muted text-nowrap">
                                    @a.CreatedAt.ToString("MMM dd, yyyy h:mm tt")
                                </td>
                                <td>
                                    <a href="/Staff/ReportDetails/@a.ReportID">#@a.ReportID</a>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@a.Report.IncidentType</span>
                                </td>
                                <td class="small text-nowrap">
                                    @if (a.Action == IncidentReportActivity.Received)
                                    {
                                        <i class="bi bi-inbox me-1 text-primary"></i>
                                    }
                                    @a.Summary
                                </td>
                                <td class="small">
                                    @if (a.ActorName == "Anonymous")
                                    {
                                        <span class="text-muted fst-italic">Anonymous</span>
                                    }
                                    else
                                    {
                                        @(a.ActorName ?? "—")
                                    }
                                </td>
                                <td class="small text-muted" style="max-width:280px">
                                    <div class="text-truncate" title="@a.Note">@(a.Note ?? "")</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (Model.PageCount > 1)
{
    <nav class="mt-3 d-flex justify-content-between align-items-center">
        <small class="text-muted">
            Page @f.Page of @Model.PageCount · @Model.TotalRows entries
        </small>
        <div class="btn-group">
            <a class="btn btn-outline-secondary btn-sm @(f.Page <= 1 ? "disabled" : "")"
               asp-action="Activity" asp-all-route-data="@Route(f.Scope!, f.Page - 1)">
                <i class="bi bi-chevron-left"></i> Newer
            </a>
            <a class="btn btn-outline-secondary btn-sm @(f.Page >= Model.PageCount ? "disabled" : "")"
               asp-action="Activity" asp-all-route-data="@Route(f.Scope!, f.Page + 1)">
                Older <i class="bi bi-chevron-right"></i>
            </a>
        </div>
    </nav>
}

