@model EduConnect.Web.Models.Announcement
@*
    The review of one pending announcement: what was submitted and the
    Approve / Reject decision. Used by the full Review page and, with
    ViewData["InPanel"] set, the dashboard's side panel, where the columns
    stack and the forms carry ReturnUrl back to the dashboard.
*@
@{
    string role = ViewBag.Role;
    var inPanel = ViewData["InPanel"] as bool? == true;
    var returnUrl = ViewData["ReturnUrl"] as string;
    var chipClass = Model.FeedType == "Emergency" ? "ec-chip-emergency"
        : Model.FeedType == "NonAcademic" ? "ec-chip-nonacademic"
        : "ec-chip-academic";
}

<div class="row g-4" data-review-id="@Model.AnnouncementID">
    <!-- Announcement preview -->
    <div class="@(inPanel ? "col-12" : "col-lg-8")">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="ec-chip @chipClass">@Model.FeedType</span>
                <span class="ec-chip ec-chip-neutral">@Model.Category.CategoryName</span>
            </div>
            <div class="card-body">
                <h3 class="fw-bold @(inPanel ? "h5" : "")">@Model.Title</h3>
                <div class="text-muted small mb-3">
                    By @Model.Author.FirstName @Model.Author.LastName
                    (@Model.Author.Role.RoleName) ·
                    Submitted @Model.SubmittedAt?.ToString("MMM dd, yyyy h:mm tt")
                </div>
                <hr />
                <div style="white-space: pre-line;">@Model.Body</div>
                @if (!string.IsNullOrEmpty(Model.AttachmentURL))
                {
                    <div class="mt-3">
                        <img src="@Model.AttachmentURL" alt="Attachment" class="img-fluid rounded" style="max-height:300px;" />
                    </div>
                }
                <div class="mt-3">
                    <div class="small text-muted mb-1">Audience</div>
                    @foreach (var name in (ViewBag.AudienceNames as List<string>) ?? new List<string>())
                    {
                        <span class="ec-chip ec-chip-neutral me-1">@name</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Decision panel -->
    <div class="@(inPanel ? "col-12" : "col-lg-4")">
        <div class="card shadow-sm border-success mb-3">
            <div class="card-body">
                <h6 class="fw-bold text-success mb-3">
                    <i class="bi bi-check-circle me-2"></i>Approve
                </h6>
                <form method="post" action="/Announcement/Approve/@Model.AnnouncementID">
                    @Html.AntiForgeryToken()
                    @if (returnUrl != null)
                    {
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                    }
                    @{ var mustEscalate = role == RoleNames.Chairperson && ViewBag.MustEscalate == true; }
                    @if (role == RoleNames.Chairperson)
                    {
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" name="escalateToDean" value="true"
                                   id="escalateToDean_@Model.AnnouncementID"
                                   @(mustEscalate ? "checked" : "")
                                   @(ViewBag.CanEscalate == true && !mustEscalate ? "" : "disabled") />
                            <label class="form-check-label small" for="escalateToDean_@Model.AnnouncementID">
                                This is a Dean-level matter — send it to the Dean for final approval
                            </label>
                            @if (mustEscalate)
                            {
                                <div class="form-text">
                                    It reaches the whole college, so the Dean gives the final approval.
                                    @if (ViewBag.CanEscalate != true)
                                    {
                                        <span class="text-danger">Your college has no Dean to send it to yet.</span>
                                    }
                                </div>
                            }
                            else if (ViewBag.CanEscalate != true)
                            {
                                <div class="form-text">Your college has no Dean to send it to.</div>
                            }
                        </div>
                    }
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-check2 me-2"></i>@(mustEscalate ? "Approve and send to the Dean" : "Approve")
                    </button>
                </form>
            </div>
        </div>

        <div class="card shadow-sm border-danger">
            <div class="card-body">
                <h6 class="fw-bold text-danger mb-3">
                    <i class="bi bi-x-circle me-2"></i>Reject
                </h6>
                <form method="post" action="/Announcement/Reject/@Model.AnnouncementID">
                    @Html.AntiForgeryToken()
                    @if (returnUrl != null)
                    {
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                    }
                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="rejectionReason_@Model.AnnouncementID">
                            Reason for rejection <span class="text-danger">*</span>
                        </label>
                        <textarea name="rejectionReason"
                                  id="rejectionReason_@Model.AnnouncementID"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Provide a reason for rejection"
                                  required></textarea>
                    </div>
                    <button type="submit" class="btn btn-outline-danger w-100">
                        <i class="bi bi-x me-2"></i>Reject
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
