@{
    ViewData["Title"] = "Create Group";
    // Set by the POST when it re-shows the form after an error.
    var keptCategory = ViewData["Category"] as string;
    var categoryKept = new[] { "Study Group", "Project Team", "Research", "Hobby & Arts",
        "Sports & Fitness", "Tech & Gaming", "Volunteer & Advocacy", "Culture & Faith" }
        .Contains(keptCategory);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-plus-circle me-2 text-primary"></i>
            Create a Group
        </h4>
        <small class="text-muted">Find your people — academic or otherwise.</small>
    </div>
    <a href="/Group" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }
                <form method="post" action="/Group/Create">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Group Name <span class="text-danger">*</span>
                        </label>
                        <input type="text" name="name" class="form-control"
                               maxlength="150" required
                               placeholder="e.g. DS101 Finals Study Group"
                               value="@ViewData["Name"]" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Category <span class="text-danger">*</span>
                        </label>
                        <select name="category" class="form-select" required>
                            <option value="" disabled selected="@(!categoryKept)">Select a category...</option>
                            <optgroup label="Academic">
                                <option value="Study Group" selected="@(keptCategory == "Study Group")">Study Group</option>
                                <option value="Project Team" selected="@(keptCategory == "Project Team")">Project Team</option>
                                <option value="Research" selected="@(keptCategory == "Research")">Research</option>
                            </optgroup>
                            <optgroup label="Interest">
                                <option value="Hobby & Arts" selected="@(keptCategory == "Hobby & Arts")">Hobby &amp; Arts</option>
                                <option value="Sports & Fitness" selected="@(keptCategory == "Sports & Fitness")">Sports &amp; Fitness</option>
                                <option value="Tech & Gaming" selected="@(keptCategory == "Tech & Gaming")">Tech &amp; Gaming</option>
                                <option value="Volunteer & Advocacy" selected="@(keptCategory == "Volunteer & Advocacy")">Volunteer &amp; Advocacy</option>
                                <option value="Culture & Faith" selected="@(keptCategory == "Culture & Faith")">Culture &amp; Faith</option>
                            </optgroup>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="description" class="form-control" rows="3"
                                  maxlength="1000"
                                  placeholder="What is this group about?">@ViewData["Description"]</textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            Max Members <span class="text-danger">*</span>
                        </label>
                        <input type="number" name="maxMembers" class="form-control"
                               min="2" max="50" value="@(ViewData["MaxMembers"] ?? 10)" required />
                        <div class="form-text">Between 2 and 50. You count as 1 toward this limit.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Create Group
                        </button>
                        <a href="/Group" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
