@using EduConnect.Web
@using EduConnect.Web.ViewModels
@model OrgDirectoryViewModel
@{
    ViewData["Title"] = "Organizations";
}

<div class="d-flex justify-content-between
            align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-people me-2 text-primary"></i>
            Organizations
        </h4>
        <small class="text-muted">
            @(Model.CanFollow
                ? "Follow organizations to see their announcements"
                : "Student organizations")
        </small>
    </div>
    @if (Model.OfficerOrgID is int officerOrgId)
    {
        <a href="/Org/Post/@officerOrgId" class="btn btn-warning btn-sm">
            <i class="bi bi-plus-circle me-1"></i>
            New Post
        </a>
    }
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible mb-4">
        <i class="bi bi-exclamation-circle me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.CanFollow)
{
    <h6 class="fw-semibold mb-2 text-muted small">ORGS YOU FOLLOW</h6>
    @if (!Model.Following.Any())
    {
        <div class="alert alert-info small mb-4">
            <i class="bi bi-info-circle me-1"></i>
            Follow the organizations you care about to see their announcements.
        </div>
    }
    else
    {
        <div class="mb-4">
            @foreach (var row in Model.Following)
            {
                <partial name="_OrgDirectoryRow" model="row" view-data="ViewData" />
            }
        </div>
    }

    <h6 class="fw-semibold mb-2 text-muted small">DISCOVER ORGANIZATIONS</h6>
}

@if (!Model.Discover.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="ec-empty">
                <i class="bi bi-people"></i>
                @(Model.CanFollow ? "You follow every organization." : "No organizations found.")
            </div>
        </div>
    </div>
}
@foreach (var row in Model.Discover)
{
    <partial name="_OrgDirectoryRow" model="row" view-data="ViewData" />
}
