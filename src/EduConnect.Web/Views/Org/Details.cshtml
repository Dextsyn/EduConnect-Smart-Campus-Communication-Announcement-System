@using EduConnect.Web
@using EduConnect.Web.Models
@model Organization
@{
    ViewData["Title"] = Model.OrgName;
    bool isOfficer = (bool)ViewBag.IsOfficer;
    bool canSeePosts = (bool)ViewBag.CanSeePosts;
    string relation = (string)ViewBag.Relation;
    int followerCount = (int)ViewBag.FollowerCount;
    bool canEditAboutUs = isOfficer ||
        Context.Session.GetString("RoleName") == RoleNames.Administrator;
    var posts = ViewBag.Announcements as List<OrgAnnouncement>
        ?? new List<OrgAnnouncement>();
    var returnUrl = $"/Org/Details/{Model.OrgID}";
}

<div class="ec-hero mb-4">
    <div style="position:relative;z-index:1">
        <div class="d-flex align-items-start gap-4 flex-wrap">
            @if (!string.IsNullOrEmpty(Model.LogoURL))
            {
                <img src="@Model.LogoURL"
                     class="rounded-circle ec-avatar-ring"
                     width="80" height="80"
                     style="object-fit:cover;" />
            }
            else
            {
                <div class="rounded-circle bg-white bg-opacity-10
                            d-flex align-items-center justify-content-center"
                     style="width:80px;height:80px;">
                    <i class="bi bi-building text-white fs-2"></i>
                </div>
            }
            <div class="flex-grow-1">
                <h4 class="fw-bold mb-1">@Model.OrgName</h4>
                <span class="ec-chip ec-chip-neutral mb-2">
                    @(Model.College?.Name ?? "University-wide")
                </span>
                <p class="ec-hero-sub small mt-2 mb-0">
                    <i class="bi bi-people me-1"></i>
                    @followerCount @(followerCount == 1 ? "follower" : "followers")
                </p>
            </div>
            <div class="d-flex gap-2 flex-wrap align-items-start">
                @if (isOfficer)
                {
                    <a href="/Org/Post/@Model.OrgID"
                       class="btn btn-warning btn-sm">
                        <i class="bi bi-plus-circle me-1"></i>
                        New Post
                    </a>
                }
                @if (relation == OrgRelation.None)
                {
                    <form method="post" action="/Org/Follow/@Model.OrgID" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="btn btn-warning btn-sm">
                            <i class="bi bi-plus-lg me-1"></i> Follow
                        </button>
                    </form>
                }
                else if (relation == OrgRelation.Following)
                {
                    <form method="post" action="/Org/Unfollow/@Model.OrgID" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="btn btn-outline-light btn-sm"
                                title="Click to unfollow">
                            <i class="bi bi-check-lg me-1"></i> Following
                        </button>
                    </form>
                }
                else if (relation == OrgRelation.Member)
                {
                    <button type="button" class="btn btn-outline-light btn-sm" disabled>
                        <i class="bi bi-person-check me-1"></i> Member
                    </button>
                }
                <a href="/Org" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible mb-4">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible mb-4">
        <i class="bi bi-exclamation-circle me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* About Us and officers (_OrgAboutUs) — the whole page for non-followers, a tab for followers. *@
@{ ViewData["CanEditAboutUs"] = canEditAboutUs; }

@if (!canSeePosts)
{
    <partial name="_OrgAboutUs" model="Model" view-data="ViewData" />

    <div class="card border-0 shadow-sm mt-3">
        <div class="card-body text-center py-4">
            <i class="bi bi-lock fs-3 text-primary"></i>
            <div class="fw-semibold mt-2">Announcements are for followers</div>
            @if (relation == OrgRelation.None)
            {
                <div class="text-muted small mb-3">
                    Follow this org to see its posts and get notified when it posts something new.
                </div>
            }
            @if (relation == OrgRelation.None)
            {
                <form method="post" action="/Org/Follow/@Model.OrgID" class="m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="btn btn-primary btn-sm">
                        Follow @Model.OrgName
                    </button>
                </form>
            }
        </div>
    </div>
}
else
{
    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-bs-toggle="tab"
                    data-bs-target="#org-posts" type="button" role="tab">
                Announcements (@posts.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab"
                    data-bs-target="#org-about" type="button" role="tab">
                About Us
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="org-posts" role="tabpanel">
            @if (!posts.Any())
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="ec-empty">
                            <i class="bi bi-people"></i>
                            No announcements yet.
                            @if (isOfficer)
                            {
                                <div class="mt-2">
                                    <a href="/Org/Post/@Model.OrgID" class="btn btn-primary btn-sm">
                                        Post the first announcement
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            @foreach (var post in posts)
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    @if (post.IsPinned)
                                    {
                                        <i class="bi bi-pin-angle-fill text-danger"
                                           title="Pinned"></i>
                                    }
                                    <h6 class="fw-bold mb-0">@post.Title</h6>
                                </div>
                                <p class="text-muted mb-2" style="white-space:pre-line;">@post.Body</p>
                            </div>
                            <div class="text-muted small text-nowrap">
                                @post.PostedAt.ToString("MMM d, yyyy")
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(post.PhotoURL))
                        {
                            <img src="@post.PhotoURL" alt="Photo for @post.Title"
                                 class="img-fluid rounded mb-2"
                                 style="width:100%;max-height:420px;object-fit:cover;" />
                        }
                        @if (!string.IsNullOrEmpty(post.AttachmentURL))
                        {
                            <a href="@post.AttachmentURL"
                               target="_blank"
                               class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-paperclip me-1"></i> Attachment
                            </a>
                        }
                        <div class="text-muted small mt-2">
                            <i class="bi bi-person-circle me-1"></i>
                            @post.PostedBy.FirstName @post.PostedBy.LastName
                            @if (post.ExpiresAt.HasValue)
                            {
                                <span class="ms-2">
                                    <i class="bi bi-clock me-1"></i>
                                    Expires @post.ExpiresAt.Value.ToString("MMM d, yyyy")
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="tab-pane fade" id="org-about" role="tabpanel">
            <partial name="_OrgAboutUs" model="Model" view-data="ViewData" />
        </div>
    </div>
}
