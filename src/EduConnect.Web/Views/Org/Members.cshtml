@model EduConnect.Web.ViewModels.OrgMembersViewModel
@{
    ViewData["Title"] = "Members & Officers";
    var org = Model.Org;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1">
            <i class="bi bi-people me-2 text-primary"></i>
            @org.OrgName
        </h4>
        <small class="text-muted">
            Members &amp; Organization Officers
            @if (!org.IsActive)
            {
                <span class="badge bg-secondary ms-1">Inactive organization</span>
            }
        </small>
    </div>
    <div class="d-flex gap-2">
        <a href="/Org/Edit/@org.OrgID" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit details
        </a>
        <a href="/Org/Manage" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible mb-4">
        <i class="bi bi-check-circle me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible mb-4">
        <i class="bi bi-exclamation-circle me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ─── OFFICERS ───────────────────────────── -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <h6 class="fw-bold mb-1">
            <i class="bi bi-person-badge me-1 text-primary"></i>
            Organization Officers (@Model.Officers.Count)
        </h6>
        <p class="text-muted small mb-3">
            Officers post this organization's announcements directly, and its
            members are notified. Pick officers from the organization's members.
            A student can be an officer of more than one organization.
        </p>

        @if (Model.Officers.Any())
        {
            <div class="table-responsive mb-3">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Officer</th>
                            <th>Title</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.Officers)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">
                                        @o.Name
                                        @if (!o.IsEligible)
                                        {
                                            <span class="badge bg-secondary ms-1"
                                                  title="Deactivated or no longer a verified student — cannot post">
                                                Inactive account
                                            </span>
                                        }
                                    </div>
                                    <small class="text-muted">@o.StudentID · @o.Placement · @o.Email</small>
                                </td>
                                <td style="min-width:220px">
                                    <form method="post" action="/Org/AssignOfficer"
                                          class="d-flex gap-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orgId" value="@org.OrgID" />
                                        <input type="hidden" name="memberId" value="@o.MemberID" />
                                        <input type="text" name="position" value="@o.Position"
                                               maxlength="100" placeholder="e.g. President"
                                               class="form-control form-control-sm"
                                               aria-label="Title for @o.Name" />
                                        <button type="submit" class="btn btn-outline-primary btn-sm"
                                                title="Save title">
                                            <i class="bi bi-check"></i>
                                        </button>
                                    </form>
                                </td>
                                <td class="text-end">
                                    <form method="post" action="/Org/UnassignOfficer" class="d-inline"
                                          data-confirm="Remove @o.Name as an officer? They stay a member.">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orgId" value="@org.OrgID" />
                                        <input type="hidden" name="memberId" value="@o.MemberID" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            Remove officer
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-warning small py-2">
                <i class="bi bi-exclamation-triangle me-1"></i>
                No officers yet — nobody can post for this organization.
            </div>
        }

        <label for="officerQuery" class="form-label fw-semibold small text-uppercase text-muted">
            Assign an officer
        </label>
        <input type="search" id="officerQuery" class="form-control"
               placeholder="Search this organization's members by name or student number"
               autocomplete="off" aria-describedby="officerHint" />
        <div id="officerHint" class="form-text">Type at least 2 characters.</div>
        <div id="officerResults" class="list-group mt-2"></div>

        <form id="assignForm" method="post" action="/Org/AssignOfficer"
              class="border rounded p-3 mt-2 d-none">
            @Html.AntiForgeryToken()
            <input type="hidden" name="orgId" value="@org.OrgID" />
            <input type="hidden" name="memberId" id="assignMemberId" />
            <div class="fw-semibold" id="assignName"></div>
            <small class="text-muted d-block mb-2" id="assignDetail"></small>
            <div class="d-flex gap-2 flex-wrap">
                <input type="text" name="position" maxlength="100"
                       class="form-control" style="max-width:260px"
                       placeholder="Title (optional), e.g. President"
                       aria-label="Officer title" />
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-person-badge me-1"></i> Make officer
                </button>
                <button type="button" class="btn btn-outline-secondary" id="assignCancel">Cancel</button>
            </div>
        </form>
    </div>
</div>

<!-- ─── MEMBERS ────────────────────────────── -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <h6 class="fw-bold mb-3">
            <i class="bi bi-people me-1 text-primary"></i>
            Members (@Model.Members.Count)
        </h6>

        <label for="memberQuery" class="form-label fw-semibold small text-uppercase text-muted">
            Add a member
        </label>
        <input type="search" id="memberQuery" class="form-control"
               placeholder="Search verified students by name or student number"
               autocomplete="off" aria-describedby="memberHint" />
        <div id="memberHint" class="form-text">Type at least 2 characters.</div>
        <div id="memberResults" class="list-group mt-2 mb-3"></div>

        <form id="addMemberForm" method="post" action="/Org/AddMember" class="d-none">
            @Html.AntiForgeryToken()
            <input type="hidden" name="orgId" value="@org.OrgID" />
            <input type="hidden" name="userId" id="addMemberUserId" />
        </form>

        @if (Model.Members.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Student no.</th>
                            <th>Program</th>
                            <th>Joined</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.Members)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold">@m.Name</span>
                                    @if (m.IsOfficer)
                                    {
                                        <span class="badge bg-primary ms-1">Officer</span>
                                    }
                                    @if (!m.IsEligible)
                                    {
                                        <span class="badge bg-secondary ms-1">Inactive account</span>
                                    }
                                    <div class="small text-muted">@m.Email</div>
                                </td>
                                <td>@m.StudentID</td>
                                <td class="small">@m.Placement</td>
                                <td class="small text-muted">@m.JoinedAt.ToString("MMM d, yyyy")</td>
                                <td class="text-end">
                                    <form method="post" action="/Org/RemoveMember" class="d-inline"
                                          data-confirm="Remove @m.Name from @org.OrgName?@(m.IsOfficer ? " This also ends their officer role." : "")">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orgId" value="@org.OrgID" />
                                        <input type="hidden" name="memberId" value="@m.MemberID" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-person-dash"></i>
                                            <span class="d-none d-md-inline">Remove</span>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="ec-empty">
                <i class="bi bi-people"></i>
                No members yet. Search above to add students.
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
(() => {
    const orgId = @org.OrgID;

    for (const form of document.querySelectorAll('form[data-confirm]'))
        form.addEventListener('submit', e => {
            if (!confirm(form.dataset.confirm)) e.preventDefault();
        });

    // Search-as-you-type with a debounce; a stale response is dropped.
    function picker(input, results, url, emptyText, render) {
        let timer = null, seq = 0;
        input.addEventListener('input', () => {
            clearTimeout(timer);
            timer = setTimeout(() => search(input.value.trim()), 300);
        });

        async function search(q) {
            const mine = ++seq;
            if (q.replace(/\s/g, '').length < 2) {
                results.replaceChildren();
                return;
            }
            let data;
            try {
                const res = await fetch(url + '?orgId=' + orgId + '&q=' + encodeURIComponent(q));
                data = await res.json();
            } catch {
                data = { error: 'network' };
            }
            if (mine !== seq) return;

            results.replaceChildren();
            if (data.error) {
                results.append(note('Search failed. Try again.', 'text-danger'));
                return;
            }
            if (!data.results.length) {
                results.append(note(emptyText(q), 'text-muted'));
                return;
            }
            for (const r of data.results) results.append(render(r));
        }
    }

    function note(text, cls) {
        const div = document.createElement('div');
        div.className = 'list-group-item small ' + cls;
        div.textContent = text;
        return div;
    }

    function item(r, badgeText, badgeClass, enabled, onPick) {
        const el = document.createElement('button');
        el.type = 'button';
        el.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-2';
        el.disabled = !enabled;

        const who = document.createElement('div');
        const name = document.createElement('div');
        name.className = 'fw-semibold';
        name.textContent = r.name;
        const detail = document.createElement('small');
        detail.className = 'text-muted';
        detail.textContent = r.studentID + ' · ' + r.placement + ' · ' + r.email;
        who.append(name, detail);
        if (r.officerOf) {
            const also = document.createElement('small');
            also.className = 'd-block text-muted';
            also.textContent = 'Also an officer of ' + r.officerOf;
            who.append(also);
        }
        el.append(who);

        if (badgeText) {
            const badge = document.createElement('span');
            badge.className = 'badge ' + badgeClass;
            badge.textContent = badgeText;
            el.append(badge);
        }
        if (enabled) el.addEventListener('click', () => onPick(r));
        return el;
    }

    // Officers: this organization's members only.
    const assignForm = document.getElementById('assignForm');
    const officerResults = document.getElementById('officerResults');
    const officerQuery = document.getElementById('officerQuery');
    picker(officerQuery, officerResults, '/Org/SearchMembers',
        q => 'No member matches “' + q + '”. Add them as a member below first.',
        r => {
            if (r.isOfficer) return item(r, 'Already an officer', 'bg-primary', false);
            return item(r, 'Select', 'bg-light text-primary border', true, pick => {
                document.getElementById('assignMemberId').value = pick.memberID;
                document.getElementById('assignName').textContent = pick.name;
                document.getElementById('assignDetail').textContent = pick.studentID + ' · ' + pick.placement + ' · ' + pick.email;
                assignForm.classList.remove('d-none');
                officerResults.replaceChildren();
                assignForm.querySelector('[name=position]').focus();
            });
        });
    document.getElementById('assignCancel').addEventListener('click', () => {
        assignForm.classList.add('d-none');
        officerQuery.focus();
    });

    // Members: any verified student who isn't a member yet.
    const addForm = document.getElementById('addMemberForm');
    picker(document.getElementById('memberQuery'), document.getElementById('memberResults'),
        '/Org/SearchStudents',
        q => 'No verified student matches “' + q + '” who isn’t already a member.',
        r => item(r, 'Add', 'bg-success', true, pick => {
            if (!confirm('Add ' + pick.name + ' (' + pick.studentID + ') as a member?')) return;
            document.getElementById('addMemberUserId').value = pick.userID;
            addForm.submit();
        }));
})();
</script>
}
